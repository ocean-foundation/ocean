package main;
import "github.com/ocean-foundation/ocean/compiler/util";
import "strings";

// Keep the runtime generator in Ocean so Make only needs the bootstrap compiler.
func main() int {
    dir := "compiler/runtime/";
    out := "package runtime;\n\n// Generated by tools/embedruntime from the .c files in this directory.\n\n";
    files := []string{"core.c", "threads.c", "process.c", "ffi.c", "wasm.c"};
    names := []string{"Core", "Threads", "Process", "Ffi", "Wasm"};
    for (i, file := range files) {
        source, ok := util.ReadFile(dir + file);
        if (!ok || strings.Contains(source, "`")) { util.Stderr("cannot embed " + file + "\n"); return 1; }
        source = strings.ReplaceAll(source, "\r\n", "\n");
        out += "func " + names[i] + "() string {\n    return `" + source + "`;\n}\n";
        if (i + 1 < len(files)) out += "\n";
    }
    old, ok := util.ReadFile(dir + "source.oc");
    if (ok && old == out) return 0;
    if (!util.WriteFile(dir + "source.oc", out)) { util.Stderr("cannot write embedded runtime\n"); return 1; }
    return 0;
}
