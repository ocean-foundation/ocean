package check;
import "github.com/ocean-foundation/ocean/compiler/ast";

// intFits reports implicit integer widening from a to d (§7.2 rule 2).
func intFits(a *ast.Type, d *ast.Type) bool {
    if (a.signed == d.signed) return d.bits >= a.bits;
    if (!a.signed && d.signed) return d.bits > a.bits;
    return false;
}

// elementCompatible: collection element types convert exactly (§7.2 rule 10).
func elementCompatible(c *Checker, a *ast.Type, d *ast.Type) bool {
    if (Identical(a, d)) return true;
    if (a.kind == ast.TK.Int || d.kind == ast.TK.Int) return false;
    if (a.kind == ast.TK.Float || d.kind == ast.TK.Float) return false;
    if (IsInterface(d) && !IsInterface(a)) return false;
    return false;
}

// Assignable reports whether a value of type a can be stored in d.
func (c *Checker) Assignable(a *ast.Type, d *ast.Type) bool {
    if (nilT(a) || nilT(d)) return false;
    if (a.kind == ast.TK.Invalid || d.kind == ast.TK.Invalid) return true;
    if (Identical(a, d)) return true;
    if (a.kind == ast.TK.Int && d.kind == ast.TK.Int) return intFits(a, d);
    if (a.kind == ast.TK.Float && d.kind == ast.TK.Float) return a.bits <= d.bits;
    if (a.kind == ast.TK.Null && d.kind == ast.TK.Named) return c.Assignable(a, Underlying(d));
    if (a.kind == ast.TK.Null) return d.kind == ast.TK.Interface || IsOptional(d) || d.kind == ast.TK.Union;
    if (d.kind == ast.TK.Interface) {
        if (IsAny(d)) return a.kind != ast.TK.Void && a.kind != ast.TK.Tuple;
        if (a.kind == ast.TK.Interface) return true;
        if (len(d.terms) > 0 && len(methodsOf(c, d)) == 0) return inTerms(c, a, d);
        return c.Implements(a, d);
    }
    if (IsVoidPtr(d) && (a.kind == ast.TK.Ptr || (a.kind == ast.TK.Buffer && a.len == -2))) return true;
    if (d.kind == ast.TK.Union) {
        if (a.kind == ast.TK.Union) {
            for (i, t := range a.terms) { if (a.tilde[i] || !inTerms(c, t, d)) return false; }
            return true;
        }
        if (inTerms(c, a, d)) return true;
        return !nilT(unionWidenTarget(c, a, d));
    }
    if (d.kind == ast.TK.Family) return (a.kind == ast.TK.Struct || a.kind == ast.TK.Enum) && a.sym == d.sym;
    if (a.kind == ast.TK.String && d.kind == ast.TK.Dyn && !d.isMixed && Identical(d.elem, tI8)) return true;
    if (d.kind == ast.TK.String && a.kind == ast.TK.Dyn && !a.isMixed && Identical(a.elem, tI8)) return true;
    if (d.kind == ast.TK.Buffer) {
        if (nilT(d.elem)) return a.kind == ast.TK.Buffer;
        if (a.kind != ast.TK.Buffer || nilT(a.elem)) return false;
        if (d.len == -2) return Identical(a.elem, d.elem);
        return a.len == d.len && Identical(a.elem, d.elem);
    }
    if (d.kind == ast.TK.Array && a.kind == ast.TK.Array) {
        if (d.len == -2) {
            if (IsAny(d.elem)) return true;
            if (Identical(a.elem, d.elem)) return true;
            return a.elem.kind == ast.TK.Array && d.elem.kind == ast.TK.Array && c.Assignable(a.elem, d.elem);
        }
        if (d.len >= 0 && a.len != d.len) return false;
        if (Identical(a.elem, d.elem)) return true;
        // nested arrays erase lengths elementwise: [2][2]int → array<array<int>>
        return d.len < 0 && a.elem.kind == ast.TK.Array && d.elem.kind == ast.TK.Array && c.Assignable(a.elem, d.elem);
    }
    if (d.kind == ast.TK.Dyn && a.kind == ast.TK.Dyn && IsInterface(d.elem) && !IsInterface(a.elem) && c.Assignable(a.elem, d.elem)) return true;
    if (d.kind == ast.TK.Dyn && a.kind == ast.TK.Dyn) {
        // interface elements convert with a runtime conformance check (§7.2 rules 4, 10)
        if (IsInterface(Underlying(a.elem)) && IsInterface(Underlying(d.elem))) return true;
        if (d.isMixed && !a.isMixed) return Identical(a.elem, d.elem) || (IsInterface(d.elem) && c.Assignable(a.elem, d.elem) && !IsInterface(a.elem) && false);
        return false;
    }
    if (a.kind == ast.TK.Param && d.kind == ast.TK.Param) return a.sym == d.sym;
    // a parameter constrained to exactly one concrete type is that type
    if (a.kind == ast.TK.Param && !nilT(a.sym.constraint)) {
        k := a.sym.constraint;
        if (k.kind != ast.TK.Union && k.kind != ast.TK.Interface && k.kind != ast.TK.Family && k.kind != ast.TK.Param) return c.Assignable(k, d);
        if ((k.kind == ast.TK.Union || k.kind == ast.TK.Interface) && len(k.terms) == 1 && !k.tilde[0]) return c.Assignable(k.terms[0], d);
    }
    return false;
}

// unionWidenTarget finds the first union term a narrower numeric value widens to.
func unionWidenTarget(c *Checker, a *ast.Type, d *ast.Type) *ast.Type {
    for (i, t := range d.terms) {
        if (d.tilde[i]) continue;
        if (a.kind == ast.TK.Int && t.kind == ast.TK.Int && intFits(a, t)) return t;
        if (a.kind == ast.TK.Float && t.kind == ast.TK.Float && a.bits <= t.bits) return t;
    }
    return zero(*ast.Type);
}

// coerce checks an expression against a destination type, retyping literals.
// Errors are reported at `at`. Returns false on mismatch.
func coerce(c *Checker, n *ast.Node, d *ast.Type, at *ast.Node) bool {
    t := n.ty;
    if (nilT(t) || nilT(d)) return true;
    if (t.kind == ast.TK.Invalid || d.kind == ast.TK.Invalid) return true;
    if (d.kind == ast.TK.Void) { err(c, at, "void has no value representation"); return false; }
    if (t.kind == ast.TK.Tuple) {
        err(c, at, "multiple-return call must be the only expression in a value list");
        return false;
    }
    if (n.kind == ast.NK.Member && n.sem == ast.Sem.EnumSelector && n.ival >= 0 && (t.kind == ast.TK.Enum)) {
        vs := c.VariantsOf(t);
        if (n.ival < len(vs) && (vs[n.ival].vkind == 1 || vs[n.ival].vkind == 2)) { err(c, n, "enum payload variant requires construction"); return false; }
    }
    if (t.kind == ast.TK.UntypedInt) return coerceIntLit(c, n, d, at);
    if (t.kind == ast.TK.UntypedFloat) return coerceFloatLit(c, n, d, at);
    if (t.kind == ast.TK.Void) { err(c, at, "function returns no value"); return false; }
    if (c.Assignable(t, d)) return true;
    // An `any` value is not implicitly assignable to collections.
    mismatch(c, at, d, t);
    return false;
}

func coerceIntLit(c *Checker, n *ast.Node, d *ast.Type, at *ast.Node) bool {
    l := intLiteral(c, n);
    if (d.kind == ast.TK.Param) {
        // Checked per specialization: the literal takes the argument type.
        terms := constraintTerms(c, d);
        ok := len(terms) == 0;
        for (_, term := range terms) { u := Underlying(term); if (u.kind == ast.TK.Int || u.kind == ast.TK.Float) ok = true; }
        if (ok) { setLitType(c, n, d); return true; }
    }
    u := d;
    if (u.kind == ast.TK.Union) {
        // widen to the first term the literal fits
        for (i, term := range u.terms) {
            if (u.tilde[i]) continue;
            if (term.kind == ast.TK.Int && litFits(l, term.bits, term.signed)) { setLitType(c, n, term); return true; }
            if (term.kind == ast.TK.Float) { setLitType(c, n, term); return true; }
        }
        dt := defaultLitType(l);
        setLitType(c, n, dt);
        if (c.Assignable(dt, d)) return true;
        mismatch(c, at, d, dt);
        return false;
    }
    if (u.kind == ast.TK.Int) {
        if (litFits(l, u.bits, u.signed)) { setLitType(c, n, d); return true; }
        err(c, at, "integer literal is out of range; use an explicit -> cast to narrow" + litTargetName(c, at));
        dt := defaultLitType(l);
        setLitType(c, n, dt);
        mismatch(c, at, d, dt);
        return false;
    }
    if (u.kind == ast.TK.Float) {
        setLitType(c, n, d);
        warnLiteralInfinity(c, at, l, u.bits);
        return true;
    }
    if (u.kind == ast.TK.Named) {
        dt := defaultLitType(l);
        setLitType(c, n, dt);
        mismatch(c, at, d, dt);
        return false;
    }
    dt := defaultLitType(l);
    setLitType(c, n, dt);
    if (c.Assignable(dt, d)) return true;
    if (u.kind == ast.TK.Ptr) {
        mismatch(c, at, d, dt);
        return false;
    }
    mismatch(c, at, d, dt);
    return false;
}

func litTargetName(c *Checker, at *ast.Node) string {
    if (at.kind == ast.NK.VarDecl && len(at.list) > 0) return ": " + at.list[0].name;
    return "";
}

func coerceFloatLit(c *Checker, n *ast.Node, d *ast.Type, at *ast.Node) bool {
    u := d;
    if (u.kind == ast.TK.Float) { setLitType(c, n, d); return true; }
    if (u.kind == ast.TK.Union) {
        for (i, term := range u.terms) {
            if (!u.tilde[i] && term.kind == ast.TK.Float) { setLitType(c, n, term); return true; }
        }
    }
    setLitType(c, n, tFloat);
    if (c.Assignable(tFloat, d)) return true;
    mismatch(c, at, d, tFloat);
    return false;
}

// setLitType assigns a concrete type to an untyped literal expression tree.
func setLitType(c *Checker, n *ast.Node, t *ast.Type) {
    n.ty = t;
    if (n.kind == ast.NK.Unary) setLitType(c, n.a, t);
    if (n.flag3 && n.kind == ast.NK.Comma) return;
}

// defaultType fixes untyped expression types to their defaults.
func defaultType(c *Checker, n *ast.Node, t *ast.Type) *ast.Type {
    if (nilT(t)) return tInvalid;
    if (t.kind == ast.TK.UntypedInt) {
        l := intLiteral(c, n);
        dt := defaultLitType(l);
        if (dt.kind == ast.TK.Invalid) err(c, n, "integer literal exceeds maximum signed width");
        setLitType(c, n, dt);
        return dt;
    }
    if (t.kind == ast.TK.UntypedFloat) { setLitType(c, n, tFloat); return tFloat; }
    return t;
}

func isStringPtr(t *ast.Type) bool {
    if (nilT(t)) return false;
    u := Underlying(t);
    return u.kind == ast.TK.Ptr && !nilT(u.elem) && Underlying(u.elem).kind == ast.TK.String;
}

func containsOwned(c *Checker, t *ast.Type, seen *map[string]bool) bool {
    if (nilT(t)) return false;
    switch (t.kind) {
    case ast.TK.String, ast.TK.Dyn, ast.TK.Map, ast.TK.Interface, ast.TK.Union, ast.TK.Func:
        return true;
    case ast.TK.Param:
        terms := constraintTerms(c, t);
        if (len(terms) == 0) return true;
        for (_, term := range terms) { if (containsOwned(c, term, seen)) return true; }
        return false;
    case ast.TK.Buffer:
        return t.len > 0 || t.len == -1;
    case ast.TK.Array:
        if (t.len < 0) return true;
        return !nilT(t.elem) && containsOwned(c, t.elem, seen);
    }
    k := TypeKey(t);
    sv, sok := (*seen)[k];
    if (sok && sv) return false;
    (*seen)[k] = true;
    switch (t.kind) {
    case ast.TK.Named:
        u := Underlying(t);
        if (u != t) return containsOwned(c, u, seen);
    case ast.TK.Tuple:
        for (_, r := range t.results) { if (containsOwned(c, r, seen)) return true; }
    case ast.TK.Struct:
        for (_, f := range c.FieldsOf(t)) { if (containsOwned(c, f.ty, seen)) return true; }
    case ast.TK.Enum:
        for (_, v := range c.VariantsOf(t)) {
            for (_, pt := range v.types) { if (containsOwned(c, pt, seen)) return true; }
            for (_, pf := range v.fields) { if (containsOwned(c, pf.ty, seen)) return true; }
            if (!nilT(v.fixedType) && containsOwned(c, v.fixedType, seen)) return true;
        }
    }
    return false;
}

func paramConvertibleTerms(c *Checker, t *ast.Type) []*ast.Type {
    if (t.kind == ast.TK.Param) return constraintTerms(c, t);
    out := make([]*ast.Type);
    out.append(t);
    return out;
}

// Convertible implements explicit -> conversions (§7.5).
func (c *Checker) Convertible(a *ast.Type, d *ast.Type) bool {
    if (a.kind == ast.TK.Invalid || d.kind == ast.TK.Invalid) return true;
    if (c.Assignable(a, d)) return true;
    ua := Underlying(a); ud := Underlying(d);
    if (Identical(ua, ud)) return true;
    if (d.kind == ast.TK.Named && ud.kind == ast.TK.Interface && c.Assignable(a, ud)) return true;
    if (ua.kind == ast.TK.Param || ud.kind == ast.TK.Param) {
        taList := paramConvertibleTerms(c, ua);
        tdList := paramConvertibleTerms(c, ud);
        if (len(taList) == 0 || len(tdList) == 0) return false;
        for (_, ta := range taList) {
            for (_, td := range tdList) { if (!c.Convertible(ta, td)) return false; }
        }
        return true;
    }
    numA := ua.kind == ast.TK.Int || ua.kind == ast.TK.Float || ua.kind == ast.TK.Bool;
    numD := ud.kind == ast.TK.Int || ud.kind == ast.TK.Float || ud.kind == ast.TK.Bool;
    if (numA && numD) return true;
    if (ua.kind == ast.TK.Array && ud.kind == ast.TK.Array) {
        if (ua.len == -3 || ud.len == -3) return false;
        if (!Identical(ua.elem, ud.elem)) {
            if (HasParams(ua.elem) || HasParams(ud.elem)) return false;
            seenA: map[string]bool; seenD: map[string]bool;
            if (containsOwned(c, ua.elem, &seenA) || containsOwned(c, ud.elem, &seenD)) return false;
        }
        if (ua.len >= 0 && ud.len >= 0) {
            c.SizeOf(ua); c.SizeOf(ud);
            if (c.hasLayoutOverflow(ua) || c.hasLayoutOverflow(ud)) return false;
            sa, ovA := mulCap(ua.len, c.SizeOf(ua.elem), maxStaticSize(c));
            sd, ovD := mulCap(ud.len, c.SizeOf(ud.elem), maxStaticSize(c));
            return !ovA && !ovD && sa == sd;
        }
        if (!Identical(ua.elem, ud.elem)) {
            return c.SizeOf(ua.elem) == c.SizeOf(ud.elem);
        }
        return true;
    }
    ptrA := ua.kind == ast.TK.Ptr || ua.kind == ast.TK.Buffer || (ua.kind == ast.TK.Array && ua.len != -3);
    ptrD := ud.kind == ast.TK.Ptr || ud.kind == ast.TK.Buffer || (ud.kind == ast.TK.Array && ud.len != -3);
    if (ua.kind == ast.TK.Ptr && ud.kind == ast.TK.Ptr) {
        sa := isStringPtr(ua); sd := isStringPtr(ud);
        if (sa != sd && !IsVoidPtr(ua) && !IsVoidPtr(ud)) return false;
        return true;
    }
    if ((isStringPtr(ua) || isStringPtr(ud)) && ptrA && ptrD && !IsVoidPtr(ua) && !IsVoidPtr(ud)) return false;
    if (ptrA && ptrD) return true;
    if ((ptrA && ud.kind == ast.TK.Int) || (ua.kind == ast.TK.Int && ptrD)) return true;
    if (ua.kind == ast.TK.String && ud.kind == ast.TK.Dyn && Identical(ud.elem, tI8)) return true;
    if (ud.kind == ast.TK.String && ua.kind == ast.TK.Dyn && Identical(ua.elem, tI8)) return true;
    if (ua.kind == ast.TK.Struct && ud.kind == ast.TK.Struct) return layoutEquivalent(c, ua, ud);
    if (ua.kind == ast.TK.Union && (numD || ud.kind == ast.TK.Union)) return true;
    return false;
}

func layoutEquivalent(c *Checker, a *ast.Type, b *ast.Type) bool {
    fa := c.FieldsOf(a); fb := c.FieldsOf(b);
    if (len(fa) != len(fb)) return false;
    for (i := 0; i < len(fa); i++) { if (!Identical(fa[i].ty, fb[i].ty) || fa[i].bits != fb[i].bits) return false; }
    return true;
}
