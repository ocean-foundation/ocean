package util;

import "os";
import "path" as filepath;

// Host helpers over the standard library. The compiler runs on its own target,
// so the target reported by os.OS() is the host.
func Windows() bool { return os.OS() == "windows"; }
func MacOS() bool { return os.OS() == "macos"; }

// Executable is the running compiler's absolute path, with '/' separators.
func Executable() string { return filepath.ToSlash(os.Executable().unwrapOrZero()); }
