package util;

import "os";
import "os/signal";
import "strconv";
import "strings";
import "time";

extern void _exit(i32 code);
extern *void signal(i32 sig, *void handler);

savedTerminal: [256]i8;
terminalSaved := false;

// SaveTerminal records stdin's terminal settings for RestoreTerminal.
func SaveTerminal() { terminalSaved = native_tcgetattr((0->i32)->int, (savedTerminal.data)->int) == 0; }
func RestoreTerminal() {
    if (!terminalSaved) return;
    native_tcsetattr((0->i32)->int, (0->i32)->int, (savedTerminal.data)->int);
    terminalSaved = false;
}

// Process status: exited normally with Code, or killed by Signal (> 0).
struct Status { Code int; Signal int; Failed bool; }

struct Redirect { stdinPath string; stdoutFd int; stderrFd int; extraFd int; extraTarget int; dir string; }

func NewRedirect() Redirect { r: Redirect; r.stdoutFd = -1; r.stderrFd = -1; r.extraFd = -1; r.extraTarget = -1; return r; }

func decode(raw i32) Status {
    s: Status;
    st := raw -> int;
    sig := st & 127;
    if (sig == 0) { s.Code = (st >> 8) & 255; return s; }
    s.Signal = sig; s.Code = 128 + sig;
    return s;
}

func SignalName(sig int) string { if (Windows()) return strconv.Itoa(sig); return FromC((native_strsignal((sig->i32)->int) -> (buffer<i8>))); }

// spawn forks and executes argv; returns the child pid or -1.
func spawn(argv array<string>, r *Redirect) int {
    if (Windows()) return windowsSpawn(argv, r);
    storage := make([][]i8);
    for (i := 0; i < len(argv); i++) storage.append(CStr(argv[i]));
    ptrs := make([]int);
    for (i := 0; i < len(storage); i++) ptrs.append(storage[i].data -> int);
    ptrs.append(0);
    devnull := CStr("/dev/null");
    stdinPath := CStr(r.stdinPath);
    dir := CStr(r.dir);
    pid := native_fork();
    if (pid < 0) return -1;
    if (pid == 0) {
        unblockSignals();
        if (r.stdinPath != "") {
            fd := native_open((stdinPath.data)->int, (0->i32)->int, 0);
            if (fd >= 0) { native_dup2((fd)->int, (0->i32)->int); native_close((fd)->int); }
        }
        if (r.stdoutFd >= 0) native_dup2((r.stdoutFd->i32)->int, (1->i32)->int);
        if (r.stderrFd >= 0) native_dup2((r.stderrFd->i32)->int, (2->i32)->int);
        if (r.extraFd >= 0) native_dup2((r.extraFd->i32)->int, (r.extraTarget->i32)->int);
        if (r.dir != "") native_chdir((dir.data)->int);
        if (strings.IndexByte(argv[0], '/') >= 0) native_execv((storage[0].data)->int, (ptrs.data)->int);
        else native_execvp((storage[0].data)->int, (ptrs.data)->int);
        extern._exit(127->i32);
    }
    return pid -> int;
}

func wait(pid int) Status {
    if (pid <= 0) { s: Status; s.Failed = true; s.Code = 1; return s; }
    if (Windows()) {
        code: i32;
        result := WinWait((&code)->int, pid, 0);
        s: Status; s.Code = code->int; s.Failed = result == -1;
        if (s.Failed) s.Code = 1;
        return s;
    }
    raw: i32;
    for (;;) {
        r := native_waitpid((pid->i32)->int, (&raw)->int, (0->i32)->int);
        if (r >= 0) break;
        if (native_errno() == 4) continue; // EINTR
        s: Status; s.Failed = true; s.Code = 1; return s;
    }
    return decode(raw);
}

// Run executes argv with inherited standard streams.
func Run(argv array<string>) Status {
    r := NewRedirect();
    pid := spawn(argv, &r);
    if (pid < 0) { s: Status; s.Failed = true; s.Code = 1; return s; }
    return wait(pid);
}

// RunForeground runs a child, forwarding SIGINT/SIGTERM/SIGHUP to it.
func RunForeground(argv array<string>) Status {
    if (Windows()) return Run(argv);
    signal.Block();
    r := NewRedirect();
    pid := spawn(argv, &r);
    if (pid < 0) { signal.Unblock(); s: Status; s.Failed = true; s.Code = 1; return s; }
    st: Status;
    for (;;) {
        sig := signal.Wait(50000000);
        if (sig > 0) native_kill((pid->i32)->int, (sig)->int);
        done, status := WaitNoHang(pid);
        if (done) { st = status; break; }
    }
    signal.Unblock();
    return st;
}

func unblockSignals() {
    empty: buffer<i8, 128>;
    native_sigemptyset((empty)->int);
    native_sigprocmask((MacOS() ? 3 : 2), (empty)->int, (zero(buffer<i8>))->int);
}

func readAll(fd int) string {
    out := make([]i8);
    chunk := make([]i8);
    for (i := 0; i < 65536; i++) chunk.append(0);
    for (;;) {
        n := native_read((fd)->int, (chunk.data)->int, (65536)->int);
        if (n < 0) {
            if (!Windows() && native_errno() == 4) continue;
            break;
        }
        if (n == 0) break;
        out.append(chunk[0:n]...);
    }
    return out -> string;
}

// RunCapture runs argv capturing stdout and stderr together.
func RunCapture(argv array<string>) (Status, string) {
    if (Windows()) {
        path, ok := MakeTempFile("ocean-capture-");
        if (!ok) { s: Status; s.Code = 1; s.Failed = true; return s, ""; }
        fd := OpenTrunc(path);
        if (fd < 0) { Remove(path); s: Status; s.Code = 1; s.Failed = true; return s, ""; }
        r := NewRedirect(); r.stdoutFd = fd; r.stderrFd = fd;
        pid := spawn(argv, &r); Close(fd);
        s: Status;
        if (pid < 0) { s.Code = 1; s.Failed = true; } else s = wait(pid);
        text, _ := ReadFile(path); Remove(path);
        return s, text;
    }
    fds: buffer<i32, 2>;
    if (native_pipe((fds)->int) != 0) { s: Status; s.Failed = true; s.Code = 1; return s, ""; }
    SetCloexec(fds[0] -> int);
    writer := fds[1] -> int;
    if (writer <= 2) {
        // dup2(fd, fd) would leave close-on-exec set on a redirected stream.
        writer = native_fcntl(writer, MacOS() ? 67 : 1030, 3); // F_DUPFD_CLOEXEC
        CloseFd(fds[1] -> int);
        if (writer < 0) { CloseFd(fds[0] -> int); s: Status; s.Failed = true; s.Code = 1; return s, ""; }
    } else SetCloexec(writer);
    r := NewRedirect();
    r.stdoutFd = writer; r.stderrFd = writer;
    pid := spawn(argv, &r);
    CloseFd(writer);
    if (pid < 0) { native_close((fds[0])->int); s: Status; s.Failed = true; s.Code = 1; return s, ""; }
    text := readAll(fds[0]);
    native_close((fds[0])->int);
    return wait(pid), text;
}

// SpawnWith starts argv with a custom redirect; caller waits with Wait.
func SpawnWith(argv array<string>, r *Redirect) int { return spawn(argv, r); }
func Wait(pid int) Status { return wait(pid); }
func Pipe() (int, int, bool) {
    fds: buffer<i32, 2>;
    result := Windows() ? WinPipe(fds->int, 65536, 32896) : native_pipe(fds->int);
    if (result != 0) return -1, -1, false;
    return fds[0] -> int, fds[1] -> int, true;
}
func CloseFd(fd int) { native_close((fd->i32)->int); }
func ReadFd(fd int, max int) string {
    chunk := make([]i8);
    for (i := 0; i < max; i++) chunk.append(0);
    for (;;) {
        n := native_read((fd->i32)->int, (chunk.data)->int, (max)->int);
        if (n < 0) {
            if (!Windows() && native_errno() == 4) continue;
            return "";
        }
        if (n == 0) return "";
        return chunk[0:n] -> string;
    }
    return "";
}
func ReadAllFd(fd int) string { return readAll(fd->i32); }
func Kill(pid int, sig int) { if (pid <= 0) return; if (Windows()) { WinTerminate(pid, 128 + sig); return; } native_kill((pid->i32)->int, (sig->i32)->int); }
func Setenv(name string, value string) { os.Setenv(name, value); }
func Unsetenv(name string) { os.Unsetenv(name); }


// SpawnMapped starts argv with descriptor mappings (pairs: from, to). Every
// other inherited mapping source is closed in the child.


func SpawnMapped(argv array<string>, maps []int, devNullStdin bool, ownGroup bool) int {
    return SpawnMappedSig(argv, maps, devNullStdin, ownGroup, false);
}

func childConflict(fd int, srcs *buffer<int, 32>, targets *buffer<int, 32>, moved *buffer<int, 32>, nPairs int, nMoved int) bool {
    for (k := 0; k < nPairs; k++) {
        if ((*targets)[k] == fd || (*srcs)[k] == fd) return true;
    }
    for (k := 0; k < nMoved; k++) {
        if ((*moved)[k] == fd) return true;
    }
    return false;
}

// SpawnMappedSig is SpawnMapped; ignoreSignals makes the child ignore
// SIGINT/SIGTERM/SIGHUP (it is shut down through its input instead).
func SpawnMappedSig(argv array<string>, maps []int, devNullStdin bool, ownGroup bool, ignoreSignals bool) int {
    if (Windows()) {
        input := -1;
        if (devNullStdin) { p := CStr("NUL"); input = native_open(p.data->int, ReadFlags(), 0); if (input < 0) return -1; maps.append(input, 0); }
        pid := windowsSpawnMapped(argv, maps);
        if (input >= 0) Close(input);
        return pid;
    }
    pairCount := len(maps) / 2;
    if (len(argv) == 0 || pairCount > 32) return -1;
    // Pre-allocate all heap data before fork() so the child stays async-signal-safe.
    storage := make([][]i8);
    for (i := 0; i < len(argv); i++) storage.append(CStr(argv[i]));
    ptrs := make([]int);
    for (i := 0; i < len(storage); i++) ptrs.append(storage[i].data -> int);
    ptrs.append(0);
    execByPath := strings.IndexByte(argv[0], '/') >= 0;
    cmdPtr := storage[0].data -> int;
    argvPtr := ptrs.data -> int;
    devnull := CStr("/dev/null");
    devnullPtr := devnull.data -> int;
    srcs: buffer<int, 32>;
    targets: buffer<int, 32>;
    maxTarget := 2;
    for (i := 0; i < pairCount; i++) {
        srcs[i] = maps[i * 2];
        targets[i] = maps[i * 2 + 1];
        if (targets[i] > maxTarget) maxTarget = targets[i];
    }
    fdupfd := MacOS() ? 67 : 1030;
    pid := native_fork();
    if (pid < 0) return -1;
    if (pid == 0) {
        unblockSignals();
        if (ownGroup) native_setpgid((0->i32)->int, (0->i32)->int);
        extern.signal(2->i32, zero(*void)); extern.signal(15->i32, zero(*void)); extern.signal(1->i32, zero(*void)); extern.signal(13->i32, zero(*void));
        if (ignoreSignals) { ign := 1 -> (*void); extern.signal(2->i32, ign); extern.signal(15->i32, ign); extern.signal(1->i32, ign); }
        // Move sources onto safe temporary descriptors without exceeding RLIMIT_NOFILE.
        moved: buffer<int, 32>;
        for (i := 0; i < pairCount; i++) {
            src := srcs[i];
            nf := native_fcntl((src->i32)->int, fdupfd, ((maxTarget + 1)->i32)->int) -> int;
            if (nf < 0) {
                skipped: buffer<int, 32>;
                nSkipped := 0;
                cand := 3;
                for (cand <= maxTarget) {
                    candFd := native_fcntl((src->i32)->int, fdupfd, (cand->i32)->int) -> int;
                    if (candFd < 0) { nf = -1; break; }
                    if (!childConflict(candFd, &srcs, &targets, &moved, pairCount, i)) {
                        nf = candFd;
                        break;
                    }
                    if (nSkipped < 32) { skipped[nSkipped] = candFd; nSkipped++; }
                    else native_close((candFd->i32)->int);
                    cand = candFd + 1;
                }
                for (k := 0; k < nSkipped; k++) native_close((skipped[k]->i32)->int);
            }
            if (nf < 0) extern._exit(127->i32);
            moved[i] = nf;
        }
        for (i := 0; i < pairCount; i++) {
            if (native_dup2((moved[i]->i32)->int, (targets[i]->i32)->int) < 0) extern._exit(127->i32);
        }
        for (i := 0; i < pairCount; i++) native_close((moved[i]->i32)->int);
        for (i := 0; i < pairCount; i++) {
            src := srcs[i];
            used := false;
            for (j := 0; j < pairCount; j++) { if (targets[j] == src) used = true; }
            if (!used) native_close((src->i32)->int);
        }
        if (devNullStdin) {
            fd := native_open(devnullPtr, (0->i32)->int, 0);
            if (fd < 0) extern._exit(127->i32);
            if (native_dup2((fd)->int, (0->i32)->int) < 0) extern._exit(127->i32);
            if (fd != 0) native_close((fd)->int);
        }
        if (execByPath) native_execv(cmdPtr, argvPtr);
        else native_execvp(cmdPtr, argvPtr);
        extern._exit(127->i32);
    }
    if (ownGroup) native_setpgid((pid)->int, (pid)->int);
    return pid -> int;
}

// WaitNoHang reports whether pid has exited, and its status.
func WaitNoHang(pid int) (bool, Status) {
    s: Status;
    if (pid <= 0) return false, s;
    if (Windows()) { if (WinWaitFor(pid, 0) == 0) return true, wait(pid); return false, s; }
    raw: i32;
    r := native_waitpid((pid->i32)->int, (&raw)->int, (1->i32)->int);
    if (r == pid->i32) return true, decode(raw);
    return false, s;
}

// Poll waits for readability (events 1) or writability (events 4) on fds.
func Poll(fds []int, events []int, timeoutMs int) []int {
    if (Windows()) return windowsPoll(fds, events, timeoutMs);
    n := len(fds);
    buf := make([]i8);
    for (i := 0; i < n * 8 + 8; i++) buf.append(0);
    base := buf.data -> int;
    for (i := 0; i < n; i++) {
        *((base + i * 8) -> (*i32)) = fds[i] -> i32;
        *((base + i * 8 + 4) -> (*i16)) = events[i] -> i16;
        *((base + i * 8 + 6) -> (*i16)) = 0->i16;
    }
    native_poll((buf.data)->int, (n->u64)->int, (timeoutMs->i32)->int);
    out := make([]int);
    for (i := 0; i < n; i++) out.append((*((base + i * 8 + 6) -> (*i16))) -> int);
    return out;
}

func SetNonblock(fd int) { flags := native_fcntl((fd->i32)->int, (3->i32)->int, 0); native_fcntl((fd->i32)->int, (4->i32)->int, ((flags | (MacOS() ? 4 : 2048)))->int); }
func SetCloexec(fd int) { if (Windows()) { WinHandleInfo(WinHandle(fd), 1, 0); return; } native_fcntl((fd->i32)->int, (2->i32)->int, (1->i32)->int); }

// WriteSome writes without blocking indefinitely; returns bytes written or -1.
func WriteSome(fd int, s string) int {
    if (len(s) == 0) return 0;
    b := s -> []i8;
    return native_write((fd->i32)->int, (b.data)->int, (len(b))->int);
}

// MonoSeconds is a monotonic clock in seconds.
func MonoSeconds() float { return (time.Monotonic() -> float) / 1000000000.0; }
// RealNow is the wall clock as Unix seconds and nanoseconds.
func RealNow() (int, int) { now := time.Now(); return now / 1000000000, now % 1000000000; }
func KillGroup(pid int, sig int) { if (pid <= 0) return; if (Windows()) { Kill(pid, sig); return; } native_kill(((-pid)->i32)->int, (sig->i32)->int); }

// Fork duplicates the process; returns 0 in the child.
func Fork() int { return native_fork() -> int; }
// ExitNow terminates immediately without running atexit handlers.
func ExitNow(code int) { extern._exit(code->i32); }

// The CRT spawn API reparses a command line on Windows. Quote every argument,
// doubling backslashes before quotes and before the closing quote.
func windowsArg(arg string) string {
    out := "\""; slashes := 0;
    for (i := 0; i <= len(arg); i++) {
        if (i < len(arg) && arg[i] == '\\') { slashes++; continue; }
        end := i == len(arg);
        quote := !end && arg[i] == '"';
        out += strings.Repeat("\\", (end || quote) ? slashes * 2 : slashes);
        slashes = 0;
        if (end) break;
        if (quote) out += "\\";
        out += arg[i];
    }
    return out + "\"";
}
func windowsSpawn(argv array<string>, r *Redirect) int {
    if (len(argv) == 0) return -1;
    maps := make([]int);
    input := -1;
    if (r.stdinPath != "") { p := CStr(r.stdinPath == "/dev/null" ? "NUL" : r.stdinPath); input = native_open(p.data->int, ReadFlags(), 0); if (input < 0) return -1; maps.append(input, 0); }
    if (r.stdoutFd >= 0) maps.append(r.stdoutFd, 1);
    if (r.stderrFd >= 0) maps.append(r.stderrFd, 2);
    if (r.extraFd >= 0) maps.append(r.extraFd, r.extraTarget);
    old := Getcwd();
    if (r.dir != "") { dir := CStr(r.dir); if (native_chdir(dir.data->int) != 0) { if (input >= 0) Close(input); return -1; } }
    pid := windowsSpawnMapped(argv, maps);
    if (r.dir != "") { dir := CStr(old); native_chdir(dir.data->int); }
    if (input >= 0) Close(input);
    return pid;
}
func windowsSpawnMapped(argv array<string>, maps []int) int {
    storage := make([][]i8);
    for (_, arg := range argv) storage.append(CStr(windowsArg(arg)));
    ptrs := make([]int);
    for (i := 0; i < len(storage); i++) ptrs.append(storage[i].data->int);
    ptrs.append(0);
    path := CStr(argv[0]);
    saved := make([]int); moved := make([]int);
    for (i := 0; i + 1 < len(maps); i += 2) {
        // Reserved test descriptors are initially closed, or explicitly mapped
        // to themselves. Calling _dup on a closed descriptor aborts in UCRT.
        if (maps[i] == maps[i + 1]) { saved.append(-2); moved.append(-2); continue; }
        saved.append(maps[i + 1] < 3 ? WinDup(maps[i + 1]) : -1);
        moved.append(WinDup(maps[i]));
    }
    ok := true;
    for (i := 0; i + 1 < len(maps); i += 2) {
        if (moved[i / 2] == -2) continue;
        if (moved[i / 2] < 0 || native_dup2(moved[i / 2], maps[i + 1]) != 0) ok = false;
        if (moved[i / 2] >= 0) Close(moved[i / 2]);
    }
    pid := ok ? WinSpawn(1, path.data->int, ptrs.data->int) : -1;
    for (i := 0; i + 1 < len(maps); i += 2) {
        if (saved[i / 2] == -2) continue;
        if (saved[i / 2] < 0) Close(maps[i + 1]);
        else { native_dup2(saved[i / 2], maps[i + 1]); Close(saved[i / 2]); }
    }
    return pid;
}

func windowsPoll(fds []int, events []int, timeoutMs int) []int {
    start := MonoSeconds();
    for (;;) {
        out := make([]int); ready := false;
        for (i := 0; i < len(fds); i++) {
            event := 0;
            if (fds[i] >= 0) {
                if ((events[i] & 4) != 0) event = 4;
                if ((events[i] & 1) != 0) {
                    available: u32;
                    args := []int{WinHandle(fds[i]), 0, 0, 0, (&available)->int, 0};
                    if (WinPeek(args.data->int) == 0) event |= 16;
                    else if (available > 0) event |= 1;
                }
            }
            out.append(event);
            if (event != 0) ready = true;
        }
        if (ready || (timeoutMs >= 0 && (MonoSeconds() - start) * 1000.0 >= timeoutMs->float)) return out;
        WinSleep(1);
    }
}

// CreateOutput creates (truncates) path for writing; false on failure.
func CreateOutput(path string) bool {
    c := CStr(path);
    fd := native_open((c.data)->int, WriteFlags(), 493);
    if (fd < 0) return false;
    native_close(fd);
    return true;
}
