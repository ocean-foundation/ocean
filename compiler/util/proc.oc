package util;

extern i32 fork();
extern i32 execvp(buffer<i8> file, buffer<int> argv);
extern i32 execv(buffer<i8> file, buffer<int> argv);
extern i32 waitpid(i32 pid, *i32 status, i32 options);
extern void _exit(i32 code);
extern i32 dup2(i32 from, i32 to);
extern i32 pipe(buffer<i32> fds);
extern i32 close(i32 fd);
extern int read(i32 fd, buffer<i8> data, int count);
extern i32 open(buffer<i8> path, i32 flags, ...);
extern i32 chdir(buffer<i8> path);
extern *void signal(i32 sig, *void handler);
extern i32 kill(i32 pid, i32 sig);
extern buffer<i8> strsignal(i32 sig);
extern i32 setenv(buffer<i8> name, buffer<i8> value, i32 overwrite);
extern i32 unsetenv(buffer<i8> name);
extern i32 sigemptyset(buffer<i8> set);
extern i32 sigaddset(buffer<i8> set, i32 sig);
extern i32 sigprocmask(i32 how, buffer<i8> set, buffer<i8> old);
extern i32 sigtimedwait(buffer<i8> set, buffer<i8> info, buffer<i64> timeout);
extern i32 tcgetattr(i32 fd, buffer<i8> t);
extern i32 tcsetattr(i32 fd, i32 action, buffer<i8> t);

savedTerminal: [64]i8;
terminalSaved := false;

// SaveTerminal records stdin's terminal settings for RestoreTerminal.
func SaveTerminal() { terminalSaved = extern.tcgetattr(0->i32, savedTerminal.data) == 0; }
func RestoreTerminal() {
    if (!terminalSaved) return;
    extern.tcsetattr(0->i32, 0->i32, savedTerminal.data);
    terminalSaved = false;
}

// Process status: exited normally with Code, or killed by Signal (> 0).
struct Status { Code int; Signal int; Failed bool; }

struct Redirect { stdinPath string; stdoutFd int; stderrFd int; extraFd int; extraTarget int; dir string; }

func NewRedirect() Redirect { r: Redirect; r.stdoutFd = -1; r.stderrFd = -1; r.extraFd = -1; r.extraTarget = -1; return r; }

func decode(raw i32) Status {
    s: Status;
    st := raw -> int;
    sig := st & 127;
    if (sig == 0) { s.Code = (st >> 8) & 255; return s; }
    s.Signal = sig; s.Code = 128 + sig;
    return s;
}

func SignalName(sig int) string { return FromC(extern.strsignal(sig->i32)); }

// spawn forks and executes argv; returns the child pid or -1.
func spawn(argv array<string>, r *Redirect) int {
    storage := make([][]i8);
    for (i := 0; i < len(argv); i++) storage.append(CStr(argv[i]));
    ptrs := make([]int);
    for (i := 0; i < len(storage); i++) ptrs.append(storage[i].data -> int);
    ptrs.append(0);
    devnull := CStr("/dev/null");
    stdinPath := CStr(r.stdinPath);
    dir := CStr(r.dir);
    pid := extern.fork();
    if (pid < 0) return -1;
    if (pid == 0) {
        unblockSignals();
        if (r.stdinPath != "") {
            fd := extern.open(stdinPath.data, 0->i32);
            if (fd >= 0) { extern.dup2(fd, 0->i32); extern.close(fd); }
        }
        if (r.stdoutFd >= 0) extern.dup2(r.stdoutFd->i32, 1->i32);
        if (r.stderrFd >= 0) extern.dup2(r.stderrFd->i32, 2->i32);
        if (r.extraFd >= 0) extern.dup2(r.extraFd->i32, r.extraTarget->i32);
        if (r.dir != "") extern.chdir(dir.data);
        if (IndexByte(argv[0], '/') >= 0) extern.execv(storage[0].data, ptrs.data);
        else extern.execvp(storage[0].data, ptrs.data);
        extern._exit(127->i32);
    }
    return pid -> int;
}

func wait(pid int) Status {
    raw: i32;
    for (;;) {
        r := extern.waitpid(pid->i32, &raw, 0->i32);
        if (r >= 0) break;
        // EINTR retry; give up on other errors after one more try.
        r2 := extern.waitpid(pid->i32, &raw, 0->i32);
        if (r2 >= 0) break;
        s: Status; s.Failed = true; s.Code = 1; return s;
    }
    return decode(raw);
}

// Run executes argv with inherited standard streams.
func Run(argv array<string>) Status {
    r := NewRedirect();
    pid := spawn(argv, &r);
    if (pid < 0) { s: Status; s.Failed = true; s.Code = 1; return s; }
    return wait(pid);
}

// RunForeground runs a child while ignoring terminal interrupts in the parent,
// so the child receives them and the parent reports the outcome.
// RunForeground runs a child, forwarding SIGINT/SIGTERM/SIGHUP to it.
func RunForeground(argv array<string>) Status {
    set: buffer<i8, 128>;
    old: buffer<i8, 128>;
    extern.sigemptyset(set);
    extern.sigaddset(set, 2->i32); extern.sigaddset(set, 15->i32); extern.sigaddset(set, 1->i32);
    extern.sigprocmask(0->i32, set, old);
    r := NewRedirect();
    pid := spawn(argv, &r);
    if (pid < 0) { extern.sigprocmask(2->i32, old, zero(buffer<i8>)); s: Status; s.Failed = true; s.Code = 1; return s; }
    ts: buffer<i64, 2> = {0, 50000000};
    st: Status;
    for (;;) {
        sig := extern.sigtimedwait(set, zero(buffer<i8>), ts);
        if (sig > 0) extern.kill(pid->i32, sig);
        done, status := WaitNoHang(pid);
        if (done) { st = status; break; }
    }
    extern.sigprocmask(2->i32, old, zero(buffer<i8>));
    return st;
}

func unblockSignals() {
    empty: buffer<i8, 128>;
    extern.sigemptyset(empty);
    extern.sigprocmask(2->i32, empty, zero(buffer<i8>));
}

func readAll(fd i32) string {
    out := make([]i8);
    chunk := make([]i8);
    for (i := 0; i < 65536; i++) chunk.append(0);
    for (;;) {
        n := extern.read(fd, chunk.data, 65536);
        if (n <= 0) break;
        out.append(chunk[0:n]...);
    }
    return out -> string;
}

// RunCapture runs argv capturing stdout and stderr together.
func RunCapture(argv array<string>) (Status, string) {
    fds: buffer<i32, 2>;
    if (extern.pipe(fds) != 0) { s: Status; s.Failed = true; s.Code = 1; return s, ""; }
    r := NewRedirect();
    r.stdoutFd = fds[1] -> int; r.stderrFd = fds[1] -> int;
    pid := spawn(argv, &r);
    extern.close(fds[1]);
    if (pid < 0) { extern.close(fds[0]); s: Status; s.Failed = true; s.Code = 1; return s, ""; }
    text := readAll(fds[0]);
    extern.close(fds[0]);
    return wait(pid), text;
}

// SpawnWith starts argv with a custom redirect; caller waits with Wait.
func SpawnWith(argv array<string>, r *Redirect) int { return spawn(argv, r); }
func Wait(pid int) Status { return wait(pid); }
func Pipe() (int, int, bool) {
    fds: buffer<i32, 2>;
    if (extern.pipe(fds) != 0) return -1, -1, false;
    return fds[0] -> int, fds[1] -> int, true;
}
func CloseFd(fd int) { extern.close(fd->i32); }
func ReadFd(fd int, max int) string {
    chunk := make([]i8);
    for (i := 0; i < max; i++) chunk.append(0);
    n := extern.read(fd->i32, chunk.data, max);
    if (n <= 0) return "";
    return chunk[0:n] -> string;
}
func ReadAllFd(fd int) string { return readAll(fd->i32); }
func Kill(pid int, sig int) { extern.kill(pid->i32, sig->i32); }
func Setenv(name string, value string) { a := CStr(name); b := CStr(value); extern.setenv(a.data, b.data, 1->i32); }
func Unsetenv(name string) { a := CStr(name); extern.unsetenv(a.data); }

extern i32 poll(buffer<i8> fds, u64 count, i32 timeout);
extern i32 fcntl(i32 fd, i32 cmd, ...);
extern i32 clock_gettime(i32 clock, buffer<i8> ts);
extern i32 setpgid(i32 pid, i32 pgid);
extern int write(i32 fd, buffer<i8> data, int count);

// SpawnMapped starts argv with descriptor mappings (pairs: from, to). Every
// other inherited mapping source is closed in the child.
// BlockSignals defers SIGINT/SIGTERM/SIGHUP so PendingSignal can poll them.
func BlockSignals() {
    set: buffer<i8, 128>;
    extern.sigemptyset(set);
    extern.sigaddset(set, 2->i32); extern.sigaddset(set, 15->i32); extern.sigaddset(set, 1->i32);
    extern.sigprocmask(0->i32, set, zero(buffer<i8>));
}
// PendingSignal consumes one blocked SIGINT/SIGTERM/SIGHUP (0 if none).
func PendingSignal() int {
    set: buffer<i8, 128>;
    extern.sigemptyset(set);
    extern.sigaddset(set, 2->i32); extern.sigaddset(set, 15->i32); extern.sigaddset(set, 1->i32);
    ts: buffer<i64, 2> = {0, 0};
    sig := extern.sigtimedwait(set, zero(buffer<i8>), ts);
    return sig > 0 ? sig -> int : 0;
}
func UnblockSignals() { unblockSignals(); }

func SpawnMapped(argv array<string>, maps []int, devNullStdin bool, ownGroup bool) int {
    return SpawnMappedSig(argv, maps, devNullStdin, ownGroup, false);
}

// SpawnMappedSig is SpawnMapped; ignoreSignals makes the child ignore
// SIGINT/SIGTERM/SIGHUP (it is shut down through its input instead).
func SpawnMappedSig(argv array<string>, maps []int, devNullStdin bool, ownGroup bool, ignoreSignals bool) int {
    storage := make([][]i8);
    for (i := 0; i < len(argv); i++) storage.append(CStr(argv[i]));
    ptrs := make([]int);
    for (i := 0; i < len(storage); i++) ptrs.append(storage[i].data -> int);
    ptrs.append(0);
    devnull := CStr("/dev/null");
    pid := extern.fork();
    if (pid < 0) return -1;
    if (pid == 0) {
        unblockSignals();
        if (ownGroup) extern.setpgid(0->i32, 0->i32);
        extern.signal(2->i32, zero(*void)); extern.signal(15->i32, zero(*void)); extern.signal(1->i32, zero(*void)); extern.signal(13->i32, zero(*void));
        if (ignoreSignals) { ign := 1 -> (*void); extern.signal(2->i32, ign); extern.signal(15->i32, ign); extern.signal(1->i32, ign); }
        // Move sources out of the way first so mappings cannot clobber each other.
        moved := make([]int);
        for (i := 0; i + 1 < len(maps); i += 2) moved.append(extern.fcntl(maps[i]->i32, 1030->i32, 300->i32) -> int);
        for (i := 0; i + 1 < len(maps); i += 2) extern.dup2(moved[i / 2]->i32, maps[i + 1]->i32);
        for (i := 0; i < len(moved); i++) extern.close(moved[i]->i32);
        for (i := 0; i + 1 < len(maps); i += 2) {
            src := maps[i];
            used := false;
            for (j := 1; j < len(maps); j += 2) { if (maps[j] == src) used = true; }
            if (!used) extern.close(src->i32);
        }
        if (devNullStdin) {
            fd := extern.open(devnull.data, 0->i32);
            if (fd >= 0) { extern.dup2(fd, 0->i32); extern.close(fd); }
        }
        if (IndexByte(argv[0], '/') >= 0) extern.execv(storage[0].data, ptrs.data);
        else extern.execvp(storage[0].data, ptrs.data);
        extern._exit(127->i32);
    }
    if (ownGroup) extern.setpgid(pid, pid);
    return pid -> int;
}

// WaitNoHang reports whether pid has exited, and its status.
func WaitNoHang(pid int) (bool, Status) {
    raw: i32;
    r := extern.waitpid(pid->i32, &raw, 1->i32);
    s: Status;
    if (r == pid->i32) return true, decode(raw);
    return false, s;
}

// Poll waits for readability (events 1) or writability (events 4) on fds.
func Poll(fds []int, events []int, timeoutMs int) []int {
    n := len(fds);
    buf := make([]i8);
    for (i := 0; i < n * 8 + 8; i++) buf.append(0);
    base := buf.data -> int;
    for (i := 0; i < n; i++) {
        *((base + i * 8) -> (*i32)) = fds[i] -> i32;
        *((base + i * 8 + 4) -> (*i16)) = events[i] -> i16;
        *((base + i * 8 + 6) -> (*i16)) = 0->i16;
    }
    extern.poll(buf.data, n->u64, timeoutMs->i32);
    out := make([]int);
    for (i := 0; i < n; i++) out.append((*((base + i * 8 + 6) -> (*i16))) -> int);
    return out;
}

func SetNonblock(fd int) { flags := extern.fcntl(fd->i32, 3->i32); extern.fcntl(fd->i32, 4->i32, (flags | 2048->i32)); }
func SetCloexec(fd int) { extern.fcntl(fd->i32, 2->i32, 1->i32); }

// WriteSome writes without blocking indefinitely; returns bytes written or -1.
func WriteSome(fd int, s string) int {
    if (len(s) == 0) return 0;
    b := s -> []i8;
    return extern.write(fd->i32, b.data, len(b));
}

func clock(id int) (int, int) {
    ts: buffer<i8, 16>;
    extern.clock_gettime(id->i32, ts);
    base := addr(ts);
    return *(base -> (*int)), *((base + 8) -> (*int));
}
// MonoSeconds is a monotonic clock in seconds.
func MonoSeconds() float { s, ns := clock(1); return (s -> float) + (ns -> float) / 1000000000.0; }
func RealNow() (int, int) { return clock(0); }
func KillGroup(pid int, sig int) { extern.kill((-pid)->i32, sig->i32); }

// Fork duplicates the process; returns 0 in the child.
func Fork() int { return extern.fork() -> int; }
// ExitNow terminates immediately without running atexit handlers.
func ExitNow(code int) { extern._exit(code->i32); }
