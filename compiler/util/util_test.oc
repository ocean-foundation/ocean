package util;
import "os";
import "strings";
import "testing";

func TestFormatting(t *testing.T) {
    if (Hex(255->uint, 4) != "00ff") t.Error("hex");
    if (FormatFixed(1.005, 2) != "1.01" && FormatFixed(1.005, 2) != "1.00") t.Error("fixed ", FormatFixed(1.005, 2));
    if (FormatFixed(-2.5, 0) != "-3" || FormatFixed(0.25, 1) != "0.3") t.Error("fixed rounding");
    if (PadLeft("é", 3) != "  é" || PadRight("ab", 3) != "ab ") t.Error("padding");
}

func TestBuf(t *testing.T) {
    b := NewBuf();
    b.Add("x=").AddInt(12).Addc(';');
    if (b.String() != "x=12;" || b.Len() != 5 || b.Last() != ';') t.Error("buf");
    b.Truncate(2);
    if (b.String() != "x=") t.Error("truncate");
}

func TestPaths(t *testing.T) {
    if (Clean("a/./b/../c//") != "a/c") t.Error("clean ", Clean("a/./b/../c//"));
    if (Clean("/../x") != "/x") t.Error("clean abs");
    if (Clean("../x") != "../x") t.Error("clean rel");
    if (Dir("a/b/c") != "a/b" || Dir("c") != "." || Dir("/c") != "/") t.Error("dir");
    if (Base("a/b/c/") != "c") t.Error("base");
    if (Rel("/a/b", "/a/b/c/d") != "c/d" || Rel("/a", "/x") != "/x") t.Error("rel");
    if (JoinPath(".", "x") != "x" || JoinPath("a/", "x") != "a/x") t.Error("joinpath");
}

func TestFiles(t *testing.T) {
    dir, ok := MakeTempDir("ocean-util-test-");
    if (!ok) { t.Fatal("tempdir"); }
    path := dir + "/f.txt";
    if (!WriteFile(path, "content\n")) t.Error("write");
    text, rok := ReadFile(path);
    if (!rok || text != "content\n") t.Error("read");
    if (!IsRegular(path) || IsDir(path) || !IsDir(dir) || StatSize(path) != 8) t.Error("stat");
    MkdirAll(dir + "/x/y");
    names, _ := ListDir(dir);
    if (len(names) != 2 || names[0] != "f.txt" || names[1] != "x") t.Error("list");
    RemoveAll(dir);
    if (Exists(dir)) t.Error("removeall");
}

func TestProcess(t *testing.T) {
    if (Windows()) {
        st, out := RunCapture([]string{"cmd.exe", "/d", "/c", "echo hi"}.array());
        if (st.Failed || st.Code != 0 || strings.TrimSpace(out) != "hi") t.Error("capture ", st.Code, " ", out);
        return;
    }
    st, out := RunCapture([]string{"sh", "-c", "echo hi; echo err >&2; exit 3"}.array());
    if (st.Code != 3 || out != "hi\nerr\n") t.Error("capture ", st.Code, " ", out);
    st2 := Run([]string{"sh", "-c", "kill -9 $$"}.array());
    if (st2.Signal != 9) t.Error("signal");
}

func TestHost(t *testing.T) {
    if (Windows() != (os.OS() == "windows") || MacOS() != (os.OS() == "macos")) t.Error("host OS");
    if (!IsRegular(Executable())) t.Error("executable path ", Executable());
    first := MonoSeconds();
    second := MonoSeconds();
    if (first <= 0.0 || second < first) t.Error("monotonic clock");
    if (Windows()) {
        if (Clean("C:\\one\\..\\two") != "C:/two") t.Error("drive path");
        if (Dir("C:/one") != "C:/" || Dir("C:/") != "C:/") t.Error("drive root");
        if (Clean("//server/share/../file") != "//server/share/file") t.Error("UNC root");
        if (windowsArg("a b\\") != "\"a b\\\\\"") t.Error("argument quoting");
    }
}

func TestBinaryFiles(t *testing.T) {
    dir, ok := MakeTempDir("ocean binary ");
    if (!ok) { t.Fatal("temp directory"); }
    defer RemoveAll(dir);
    path := JoinPath(dir, "with spaces.bin");
    data := "a\x00b\r\n\x1az";
    if (!WriteFile(path, data)) t.Fatal("binary write");
    actual, read := ReadFile(path);
    if (!read || actual != data || StatSize(path) != len(data)) t.Error("binary round trip");
    if (StatMtime(path) <= 0) t.Error("mtime");
    replacement := JoinPath(dir, "replacement");
    if (!WriteFile(replacement, "new") || !Rename(replacement, path)) t.Error("replace existing file");
    actual, read = ReadFile(path);
    if (!read || actual != "new") t.Error("replacement contents");
}
