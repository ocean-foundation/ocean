package util;

import "os";
import "path" as filepath;
import "strings";
import "time";

// The compiler's file-system conventions over the standard library: canonical
// paths use '/' on every host, and operations report success as a bool (or a
// value with a bool). Descriptor I/O used with child processes stays on the
// native bridges in native.oc.
extern void free(*void p);
extern int strlen(buffer<i8> s);

func CStr(s string) []i8 { b := s -> []i8; b.append(0); return b; }

func FromC(p buffer<i8>) string {
    if ((p -> int) == 0) return "";
    n := extern.strlen(p);
    out := make([]i8);
    for (i := 0; i < n; i++) out.append(p[i]);
    return out -> string;
}

func Getenv(name string) (string, bool) { return os.LookupEnv(name); }

func ReadFile(path string) (string, bool) {
    text := os.ReadFile(path);
    return text.unwrapOrZero(), !text.hasError();
}

func WriteFd(fd int, s string) bool {
    if (len(s) == 0) return true;
    b := s -> []i8;
    off := 0;
    for (off < len(b)) {
        n := native_write((fd)->int, ((&b[off]) -> (buffer<i8>))->int, (len(b) - off)->int);
        if (n < 0) {
            if (!Windows() && native_errno() == 4) continue;
            return false;
        }
        if (n == 0) return false;
        off += n;
    }
    return true;
}

func WriteBytesFd(fd int, b *[]i8) bool {
    off := 0;
    for (off < len(*b)) {
        n := native_write((fd)->int, ((&(*b)[off]) -> (buffer<i8>))->int, (len(*b) - off)->int);
        if (n < 0) {
            if (!Windows() && native_errno() == 4) continue;
            return false;
        }
        if (n == 0) return false;
        off += n;
    }
    return true;
}

func Stdout(s string) { WriteFd(1->i32, s); }
func Stderr(s string) { WriteFd(2->i32, s); }

func WriteFile(path string, s string) bool { return !os.WriteFile(path, s).hasError(); }

stageSeq := 0;

func oWrOnly() int { return Windows() ? 32769 : 1; }
func oCreat() int { return Windows() ? 256 : (MacOS() ? 512 : 64); }
func oExcl() int { return Windows() ? 1024 : (MacOS() ? 2048 : 128); }
func oNoFollow() int {
    if (Windows()) return 0;
    if (MacOS()) return 256;
    if (os.Arch() == "aarch64") return 32768;
    return 131072;
}

func uniqueToken(attempt int) string {
    stageSeq++;
    t := time.Monotonic();
    v := ((Pid() -> uint) * 1099511628211->uint) ^ (t -> uint) ^ ((stageSeq + attempt * 131) -> uint);
    return Hex(v, 16);
}

// CreateTempInDir creates a unique file inside dir using O_CREAT | O_EXCL | O_NOFOLLOW.
func CreateTempInDir(dir string, prefix string, mode int) (string, int, bool) {
    return createTempInDir(dir, prefix, "", mode);
}

func createTempInDir(dir string, prefix string, suffix string, mode int) (string, int, bool) {
    cleanDir := dir == "" ? "." : dir;
    perm := mode & 511;
    flags := oWrOnly() | oCreat() | oExcl() | oNoFollow();
    for (i := 0; i < 64; i++) {
        cand := JoinPath(cleanDir, prefix + uniqueToken(i) + suffix);
        c := CStr(cand);
        fd := native_open((c.data)->int, flags, perm) -> int;
        if (fd >= 0) return cand, fd, true;
    }
    return "", -1, false;
}

// CreateStagingPath creates a unique staging file path inside target's directory
// with the requested toolchain suffix, without following symlinks.
func CreateStagingPath(target string, mode int, suffix string) (string, bool) {
    dir := Dir(target);
    cand, fd, ok := createTempInDir(dir, ".ocean-tmp-", suffix, mode);
    if (!ok) return "", false;
    if (!Close(fd)) { Remove(cand); return "", false; }
    return cand, true;
}

// MakeTempDirIn creates a unique private directory directly inside base.
func MakeTempDirIn(base string, prefix string) (string, bool) {
    cleanBase := base == "" ? "." : base;
    for (i := 0; i < 64; i++) {
        cand := JoinPath(cleanBase, prefix + uniqueToken(i));
        if (Mkdir(cand)) {
            if (!Windows()) Chmod(cand, 448);
            return NormalizePath(cand), true;
        }
    }
    return "", false;
}

// WriteFileAtomic atomically writes s to path using an exclusive staging file
// in the same directory with permission bits masked to 0777.
func WriteFileAtomic(path string, s string, mode int) bool {
    perm := mode & 511;
    dir := Dir(path);
    tmp, fd, ok := CreateTempInDir(dir, ".ocean-tmp-", perm);
    if (!ok) return false;
    wrote := WriteFd(fd, s);
    closed := Close(fd);
    if (!wrote || !closed) { Remove(tmp); return false; }
    if (!Windows()) {
        actual := StatMode(tmp);
        if ((actual < 0 || (actual & 511) != perm) && !Chmod(tmp, perm)) {
            Remove(tmp);
            return false;
        }
    }
    if (!Rename(tmp, path)) { Remove(tmp); return false; }
    return true;
}

// WriteFileMode writes s to path safely with permission bits masked to 0777.
func WriteFileMode(path string, s string, mode int) bool {
    return WriteFileAtomic(path, s, mode & 511);
}

func WriteBufFile(path string, b *Buf) bool { return WriteFile(path, b.String()); }

// OpenTrunc opens path for writing (create/truncate) as a descriptor that can
// be passed to a child process; -1 on failure.
func OpenTrunc(path string) int {
    c := CStr(path);
    return native_open((c.data)->int, WriteFlags(), (438->u32)->int) -> int;
}
// LockFile takes an exclusive process lock. Close the returned fd to release it.
func LockFile(path string) int {
    name := CStr(path);
    flags := oWrOnly() | oCreat() | oNoFollow();
    if (Windows()) flags = (flags & ~1) | 2 | 128; // O_RDWR | O_NOINHERIT
    fd := native_open(name.data->int, flags, 420);
    if (fd < 0) return -1;
    ok := Windows() ? native_locking(fd) : lockFilePOSIX(fd);
    if (!ok) { Close(fd); return -1; }
    return fd;
}

struct LinuxFileLock { kind i16; whence i16; start i64; length i64; pid i32; }
struct DarwinFileLock { start i64; length i64; pid i32; kind i16; whence i16; }

func lockFilePOSIX(fd int) bool {
    SetCloexec(fd);
    linux: LinuxFileLock;
    darwin: DarwinFileLock;
    linux.kind = 1; darwin.kind = 3; // F_WRLCK
    mac := MacOS();
    arg := mac ? (&darwin)->int : (&linux)->int;
    for (;;) {
        if (native_fcntl(fd, mac ? 9 : 7, arg) == 0) return true; // F_SETLKW
        if (native_errno() != 4) return false; // EINTR
    }
}

func WriteString(fd int, s string) bool { return WriteFd(fd->i32, s); }
func Close(fd int) bool { return native_close((fd->i32)->int) == 0; }

func addr(b buffer<i8>) int { return b -> int; }
func BufAt(n int) buffer<i8> { p := n -> (*void); b := p -> (buffer<i8>); return b; }

// StatMode returns the mode bits of path (following links), or -1.
func StatMode(path string) int {
    info := os.Stat(path);
    return info.hasError() ? -1 : info.unwrap().Mode;
}
func StatSize(path string) int {
    info := os.Stat(path);
    return info.hasError() ? -1 : info.unwrap().Size;
}
func StatMtime(path string) int {
    info := os.Stat(path);
    return info.hasError() ? -1 : info.unwrap().ModTime;
}

func Exists(path string) bool { return os.Exists(path); }
func IsDir(path string) bool { return os.IsDir(path); }
func IsRegular(path string) bool {
    info := os.Stat(path);
    return !info.hasError() && info.unwrap().IsRegular();
}
func IsSymlink(path string) bool {
    info := os.Lstat(path);
    return !info.hasError() && info.unwrap().IsSymlink();
}
// IsExecutable reports a regular file with an execute bit (any regular file on Windows).
func IsExecutable(path string) bool {
    info := os.Stat(path);
    if (info.hasError() || !info.unwrap().IsRegular()) return false;
    return Windows() || (info.unwrap().Mode & 73) != 0;
}

// ListDir returns the entry names of a directory (excluding . and ..), sorted.
func ListDir(path string) ([]string, bool) {
    names := os.ListDir(path);
    return names.unwrapOrZero(), !names.hasError();
}

func Mkdir(path string) bool { return !os.Mkdir(path).hasError(); }
func MkdirAll(path string) bool { return !os.MkdirAll(path).hasError(); }
func Remove(path string) bool { return !os.Remove(path).hasError(); }
func Rmdir(path string) bool { return IsDir(path) && Remove(path); }
func Rename(from string, to string) bool { return !os.Rename(from, to).hasError(); }
func Chmod(path string, mode int) bool { return !os.Chmod(path, mode).hasError(); }
func RemoveAll(path string) bool { return !os.RemoveAll(path).hasError(); }

func Getcwd() string { return NormalizePath(os.Getwd().unwrapOrZero()); }

func Realpath(path string) (string, bool) {
    resolved := os.Realpath(path);
    if (resolved.hasError()) return "", false;
    return NormalizePath(resolved.unwrap()), true;
}

func TempBase() string { return NormalizePath(os.TempDir()); }

func MakeTempDir(prefix string) (string, bool) {
    dir := os.MkdirTemp(prefix);
    if (dir.hasError()) return "", false;
    return NormalizePath(dir.unwrap()), true;
}
func MakeTempFile(prefix string) (string, bool) {
    file := os.CreateTemp(prefix);
    if (file.hasError()) return "", false;
    return NormalizePath(file.unwrap()), true;
}

func ReadFlags() int { return Windows() ? 32768 : 0; }
func WriteFlags() int { return Windows() ? 33537 : (MacOS() ? 1537 : 577); }

func IsTerminal(fd int) bool { return native_isatty((fd->i32)->int) != 0; }
func Pid() int { return os.Getpid(); }

// Path helpers. Canonical internal paths use forward slashes.
func NormalizePath(path string) string { return filepath.ToSlash(path); }
func IsAbs(path string) bool { return filepath.IsAbs(path); }
func Dir(path string) string { return filepath.Dir(path); }
func Base(path string) string { return filepath.Base(path); }

// JoinPath appends b to a without cleaning, unless b is already absolute.
func JoinPath(a string, b string) string {
    a = NormalizePath(a); b = NormalizePath(b);
    if (a == "" || a == ".") return b;
    if (IsAbs(b)) return b;
    if (strings.HasSuffix(a, "/")) return a + b;
    return a + "/" + b;
}

func Clean(path string) string { return filepath.Clean(path); }

func Abs(path string) string {
    if (IsAbs(path)) return Clean(path);
    return Clean(Getcwd() + "/" + path);
}

// Rel returns path relative to base when path is inside base; otherwise path.
func Rel(base string, path string) string {
    b := Clean(base); p := Clean(path);
    if (p == b) return ".";
    if (b == "/") {
        if (len(p) > 0 && p[0] == '/') return p[1:];
        return p;
    }
    if (strings.HasPrefix(p, b + "/")) return p[len(b) + 1:];
    return p;
}

// OutputError explains why an output path cannot be created or replaced, in
// strerror's words, without depending on a platform's errno interface.
func OutputError(path string, replacing bool) string {
    if (IsDir(path)) return replacing && (Base(path) == "." || Base(path) == "..") ? "Device or resource busy" : "Is a directory";
    parent := Dir(path);
    if (parent == "") parent = ".";
    if (!Exists(parent)) return "No such file or directory";
    if (!IsDir(parent)) return "Not a directory";
    return "Permission denied";
}
