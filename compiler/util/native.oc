// _locking(fd, _LK_LOCK, 1) locks one byte at the current offset (zero).
func native_locking(fd int) bool {
    result := -1;
    asm x86_64/windows {
        mov rcx, ${fd}
        mov edx, 1
        mov r8d, 1
        sub rsp, 32
        call _locking
        add rsp, 32
        mov ${result}, rax
    }
    asm aarch64/windows {
        ldr x0, ${fd}
        mov w1, #1
        mov w2, #1
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        bl _locking
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
        add sp, sp, #80
        str x19, ${result}
    }
    return (result -> i32) == 0;
}

