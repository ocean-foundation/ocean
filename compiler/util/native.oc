    asm riscv64/linux {
        ld a0, ${a0}
        ld a1, ${a1}
        addi sp, sp, -48
        sd ra, 0(sp)
        sd t3, 8(sp)
        sd t4, 16(sp)
        sd t5, 24(sp)
        sd t6, 32(sp)
        call execvp
        mv s1, a0
        ld ra, 0(sp)
        ld t3, 8(sp)
        ld t4, 16(sp)
        ld t5, 24(sp)
        ld t6, 32(sp)
        addi sp, sp, 48
        sd s1, ${result}
