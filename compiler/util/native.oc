package util;

// Native ABI bridges written in Ocean. Platform-qualified blocks keep foreign
// symbols out of other targets. Callers use 64-bit slots, with explicit signed
// conversion for C int results. Keep these calls separate from path policy.

func native_open(a0 int, a1 int, a2 int) int {
    if (Windows()) a2 &= 384;
    result := -1;
    asm x86_64/linux {
        mov rdi, ${a0}
        mov rsi, ${a1}
        mov rdx, ${a2}
        xor eax, eax
        call open
        mov ${result}, rax
    }
    asm aarch64/linux {
        ldr x0, ${a0}
        ldr x1, ${a1}
        ldr x2, ${a2}
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        bl open
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
        add sp, sp, #80
        str x19, ${result}
    }
    asm riscv64/linux {
        ld a0, ${a0}
        ld a1, ${a1}
        ld a2, ${a2}
        addi sp, sp, -48
        sd ra, 0(sp)
        sd t3, 8(sp)
        sd t4, 16(sp)
        sd t5, 24(sp)
        sd t6, 32(sp)
        call open
        mv s1, a0
        ld ra, 0(sp)
        ld t3, 8(sp)
        ld t4, 16(sp)
        ld t5, 24(sp)
        ld t6, 32(sp)
        addi sp, sp, 48
        sd s1, ${result}
    }
    asm x86_64/macos {
        mov rdi, ${a0}
        mov rsi, ${a1}
        mov rdx, ${a2}
        xor eax, eax
        call _open
        mov ${result}, rax
    }
    asm aarch64/macos {
        ldr x0, ${a0}
        ldr x1, ${a1}
        ldr x2, ${a2}
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        str x2, [sp]
        bl _open
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
        add sp, sp, #80
        str x19, ${result}
    }
    asm x86_64/windows {
        mov rcx, ${a0}
        mov rdx, ${a1}
        mov r8, ${a2}
        sub rsp, 32
        call _open
        add rsp, 32
        mov ${result}, rax
    }
    asm aarch64/windows {
        ldr x0, ${a0}
        ldr x1, ${a1}
        ldr x2, ${a2}
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        bl _open
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
        add sp, sp, #80
        str x19, ${result}
    }
    return (result -> i32) -> int;
}

func native_read(a0 int, a1 int, a2 int) int {
    result := -1;
    asm x86_64/linux {
        mov rdi, ${a0}
        mov rsi, ${a1}
        mov rdx, ${a2}
        xor eax, eax
        call read
        mov ${result}, rax
    }
    asm aarch64/linux {
        ldr x0, ${a0}
        ldr x1, ${a1}
        ldr x2, ${a2}
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        bl read
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
        add sp, sp, #80
        str x19, ${result}
    }
    asm riscv64/linux {
        ld a0, ${a0}
        ld a1, ${a1}
        ld a2, ${a2}
        addi sp, sp, -48
        sd ra, 0(sp)
        sd t3, 8(sp)
        sd t4, 16(sp)
        sd t5, 24(sp)
        sd t6, 32(sp)
        call read
        mv s1, a0
        ld ra, 0(sp)
        ld t3, 8(sp)
        ld t4, 16(sp)
        ld t5, 24(sp)
        ld t6, 32(sp)
        addi sp, sp, 48
        sd s1, ${result}
    }
    asm x86_64/macos {
        mov rdi, ${a0}
        mov rsi, ${a1}
        mov rdx, ${a2}
        xor eax, eax
        call _read
        mov ${result}, rax
    }
    asm aarch64/macos {
        ldr x0, ${a0}
        ldr x1, ${a1}
        ldr x2, ${a2}
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        bl _read
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
        add sp, sp, #80
        str x19, ${result}
    }
    asm x86_64/windows {
        mov rcx, ${a0}
        mov rdx, ${a1}
        mov r8, ${a2}
        sub rsp, 32
        call _read
        add rsp, 32
        mov ${result}, rax
    }
    asm aarch64/windows {
        ldr x0, ${a0}
        ldr x1, ${a1}
        ldr x2, ${a2}
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        bl _read
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
        add sp, sp, #80
        str x19, ${result}
    }
    return Windows() ? ((result -> i32) -> int) : result;
}

