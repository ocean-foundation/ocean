func WinPeek(a0 int) int {
    result := -1;
    asm x86_64/windows {
        mov rcx, ${a0}
        mov r10, rcx
        mov rcx, [r10]
        mov rdx, [r10 + 8]
        mov r8, [r10 + 16]
        mov r9, [r10 + 24]
        sub rsp, 48
        mov rax, [r10 + 32]
        mov [rsp + 32], rax
        mov rax, [r10 + 40]
        mov [rsp + 40], rax
        call PeekNamedPipe
        add rsp, 48
        mov ${result}, rax
    }
    asm aarch64/windows {
        ldr x0, ${a0}
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        mov x8, x0
        ldp x0, x1, [x8]
        ldp x2, x3, [x8, #16]
        ldp x4, x5, [x8, #32]
        bl PeekNamedPipe
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
        add sp, sp, #80
        str x19, ${result}
    }
    return (result -> i32) -> int;
}

