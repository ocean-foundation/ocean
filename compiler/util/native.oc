        ld t4, 16(sp)
        ld t5, 24(sp)
        ld t6, 32(sp)
        addi sp, sp, 48
        sd s1, ${result}
    }
    asm x86_64/macos {
        mov rdi, ${a0}
        mov rsi, ${a1}
        mov rdx, ${a2}
        xor eax, eax
        call _tcsetattr
        mov ${result}, rax
    }
    asm aarch64/macos {
        ldr x0, ${a0}
        ldr x1, ${a1}
        ldr x2, ${a2}
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        bl _tcsetattr
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
        add sp, sp, #80
        str x19, ${result}
    }
    return (result -> i32) -> int;
}

func native_poll(a0 int, a1 int, a2 int) int {
    result := -1;
    asm x86_64/linux {
        mov rdi, ${a0}
        mov rsi, ${a1}
        mov rdx, ${a2}
        xor eax, eax
        call poll
        mov ${result}, rax
    }
    asm aarch64/linux {
        ldr x0, ${a0}
        ldr x1, ${a1}
        ldr x2, ${a2}
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        bl poll
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
        add sp, sp, #80
        str x19, ${result}
    }
    asm riscv64/linux {
        ld a0, ${a0}
        ld a1, ${a1}
        ld a2, ${a2}
        addi sp, sp, -48
        sd ra, 0(sp)
        sd t3, 8(sp)
        sd t4, 16(sp)
        sd t5, 24(sp)
        sd t6, 32(sp)
        call poll
        mv s1, a0
        ld ra, 0(sp)
        ld t3, 8(sp)
        ld t4, 16(sp)
        ld t5, 24(sp)
        ld t6, 32(sp)
        addi sp, sp, 48
        sd s1, ${result}
    }
    asm x86_64/macos {
        mov rdi, ${a0}
        mov rsi, ${a1}
        mov rdx, ${a2}
        xor eax, eax
        call _poll
        mov ${result}, rax
    }
    asm aarch64/macos {
        ldr x0, ${a0}
        ldr x1, ${a1}
        ldr x2, ${a2}
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        bl _poll
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
        add sp, sp, #80
        str x19, ${result}
    }
    return (result -> i32) -> int;
}

