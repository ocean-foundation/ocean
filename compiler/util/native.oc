func native_close(a0 int) int {
    result := -1;
    asm x86_64/linux {
        mov rdi, ${a0}
        xor eax, eax
        call close
        mov ${result}, rax
    }
    asm aarch64/linux {
        ldr x0, ${a0}
        sub sp, sp, #80
        stp x9, x10, [sp, #16]
        stp x11, x12, [sp, #32]
        stp x13, x14, [sp, #48]
        str x15, [sp, #64]
        bl close
        mov x19, x0
        ldp x9, x10, [sp, #16]
        ldp x11, x12, [sp, #32]
        ldp x13, x14, [sp, #48]
        ldr x15, [sp, #64]
