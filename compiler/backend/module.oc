package backend;
import "github.com/ocean-foundation/ocean/compiler/ast";
import "github.com/ocean-foundation/ocean/compiler/check";
import "github.com/ocean-foundation/ocean/compiler/util";
import "strings";

func runtimeDecls() string {
    return "declare ptr @oc_alloc(i64)\n" +
        "declare void @oc_free(ptr)\n" +
        "declare void @oc_zero(ptr, ptr)\n" +
        "declare void @oc_set_tag(ptr, i64, ptr)\n" +
        "declare void @oc_copy(ptr, ptr, ptr)\n" +
        "declare i64 @oc_equal(ptr, ptr, ptr)\n" +
        "declare i64 @oc_elems_equal(ptr, i64, ptr, i64, ptr)\n" +
        "declare i64 @oc_any_equal(ptr, ptr, ptr, ptr)\n" +
        "declare ptr @oc_box(ptr, ptr)\n" +
        "declare ptr @oc_box_elements(ptr, ptr)\n" +
        "declare ptr @oc_box_elements_block(ptr, ptr)\n" +
        "declare ptr @oc_str_concat(ptr, ptr)\n" +
        "declare ptr @oc_str_add_byte(ptr, i8, i64)\n" +
        "declare i64 @oc_str_cmp(ptr, ptr)\n" +
        "declare i64 @oc_str_eq(ptr, ptr)\n" +
        "declare ptr @oc_str_cdata(ptr)\n" +
        "declare ptr @oc_str_cdup(ptr)\n" +
        "declare ptr @oc_arr_data(ptr)\n" +
        "declare i64 @oc_arr_len(ptr)\n" +
        "declare i64 @oc_arr_cap(ptr)\n" +
        "declare ptr @oc_arr_new(i64, i64, i64)\n" +
        "declare ptr @oc_arr_new_init(i64, ptr, i64)\n" +
        "declare ptr @oc_arr_copy(ptr, ptr)\n" +
        "declare ptr @oc_arr_insert(ptr, i64, i64, i64, i64)\n" +
        "declare void @oc_arr_insert_from(ptr, i64, ptr, i64, ptr, i64)\n" +
        "declare ptr @oc_arr_push(ptr, i64)\n" +
        "declare void @oc_arr_remove(ptr, i64, i64, ptr, i64)\n" +
        "declare void @oc_arr_pop(ptr, i64, ptr, i64)\n" +
        "declare void @oc_arr_free(ptr, ptr)\n" +
        "declare void @oc_drop(ptr, ptr)\n" +
        "declare i1 @oc_elems_match(ptr, ptr, ptr, i64)\n" +
        "declare void @oc_iface_elems_check(ptr, ptr, i64)\n" +
        "declare ptr @oc_str_copy(ptr)\n" +
        "declare void @oc_free_ptr(ptr, ptr)\n" +
        "declare void @oc_hom_range(ptr, i64, i64)\n" +
        "declare ptr @oc_arr_to_block(ptr, ptr)\n" +
        "declare ptr @oc_block_copy(ptr, ptr)\n" +
        "declare ptr @oc_block_new(i64, ptr)\n" +
        "declare void @oc_init_block(ptr, ptr)\n" +
        "declare ptr @oc_slice(ptr, i64, i64, i64, ptr, i64, i64)\n" +
        "declare ptr @oc_concat(ptr, i64, ptr, i64, ptr)\n" +
        "declare ptr @oc_map_get(ptr, ptr, ptr)\n" +
        "declare void @oc_map_set(ptr, ptr, ptr, ptr, ptr)\n" +
        "declare ptr @oc_map_slot(ptr, ptr, ptr, ptr)\n" +
        "declare void @oc_map_delete(ptr, ptr, ptr)\n" +
        "declare i64 @oc_map_len(ptr)\n" +
        "declare ptr @oc_map_copy(ptr)\n" +
        "declare void @oc_map_snapshot(ptr, ptr, ptr, ptr, ptr)\n" +
        "declare ptr @oc_reflect_fields(ptr, ptr)\n" +
        "declare i64 @oc_reflect_is_struct(ptr)\n" +
        "declare i64 @oc_reflect_is_enum(ptr)\n" +
        "declare ptr @oc_reflect_var_integer(ptr, ptr)\n" +
        "declare ptr @oc_reflect_enum_variant(ptr, ptr)\n" +
        "declare ptr @oc_method(ptr, ptr, i64)\n" +
        "declare void @oc_panic(ptr, i64) noreturn\n" +
        "declare void @oc_panic_div_zero(i64) noreturn\n" +
        "declare void @oc_panic_neg_shift(i64) noreturn\n" +
        "declare void @oc_return_panic(ptr, i64) noreturn\n" +
        "declare void @oc_bounds(i64, i64, i64) noreturn\n" +
        "declare void @oc_data_literal_bounds(i64, i64, i64) noreturn\n" +
        "declare void @oc_uninit_func(i64) noreturn\n" +
        "declare void @oc_map_missing(i64) noreturn\n" +
        "declare void @oc_buf_push(ptr, ptr, ptr)\n" +
        "declare void @oc_buf_drop(ptr)\n" +
        "declare void @oc_block_copy_elems(ptr, ptr)\n" +
        "declare void @oc_data_destroy_elems(ptr, i64, ptr)\n" +
        "declare void @oc_data_copy_elems(ptr, ptr, i64, ptr)\n" +
        "declare void @oc_recover(ptr)\n" +
        "declare void @oc_run_defers(ptr)\n" +
        "declare i32 @" + recoverySymbol() + "(ptr" + (targetWindows() ? ", ptr" : "") + ") returns_twice\n" +
        "declare void @llvm.trap() noreturn\n" +
        "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n" +
        "declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)\n" +
        "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n" +
        "@oc_top = external thread_local global ptr\n" +
        "@oc_in_defer = external thread_local global i64\n" +
        "@oc_type_buflist = external global i8\n";
}

func threadDecls() string {
    return "declare void @ocean_threads_checkpoint()\n" +
        "declare i64 @ocean_threads_spawn(ptr, ptr)\n" +
        "declare void @ocean_runtime_thread_return()\n";
}

func globalDef(g *Gen, s *ast.Symbol) {
    t := sub(g, s.ty);
    name := globalRef(g, s);
    if (isAgg(t)) {
        g.globals.Add(name).Add(" = internal global [").AddInt(sizeOf(g, t)).Add(" x i8] zeroinitializer, align ").AddInt(alignOf(g, t)).Add("\n");
    } else {
        g.globals.Add(name).Add(" = internal global ").Add(ll(t)).Add(" ").Add(zeroLit(t)).Add(", align 8\n");
    }
}

// initFunction initializes globals: all to zero first, then initializers in order.
func initFunction(g *Gen, packages []*ast.Package) {
    inst := new(Inst);
    inst.kind = 3;
    inst.env = g.env;
    f := newFn(g, inst, "@oc_init_globals");
    f.cur = "entry";
    g.fn = f;
    prologue(g, "<globals>");
    for (_, p := range packages) {
        for (_, s := range p.syms) {
            if (s.kind != ast.SK.Var) continue;
            t := sub(g, s.ty);
            if (needsInit(g, t)) zeroInto(g, t, globalRef(g, s));
        }
    }
    for (_, p := range packages) {
        for (_, src := range p.files) {
            if (nilN(src.file)) continue;
            for (_, d := range src.file.list) {
                if (d.kind != ast.NK.VarDecl || len(d.list2) == 0) continue;
                genGlobalInit(g, d);
            }
        }
    }
    prev := tmp(g);
    emit(g, prev + " = load ptr, ptr " + f.frame);
    emit(g, "store ptr " + prev + ", ptr @oc_top");
    term(g, "ret void");
    emitLocalTable(g);
    g.mod.Add("define void @oc_init_globals() {\nentry:\n").AddBuf(f.allocas).AddBuf(f.body).Add("}\n\n");
}

func genGlobalInit(g *Gen, d *ast.Node) {
    names := d.list; values := d.list2;
    if (len(values) == 1 && len(names) > 1) {
        tv := genExpr(g, values[0]);
        rts := under(tv.t).results;
        for (i, id := range names) {
            if (nilS(id.sym)) continue;
            vt := sub(g, id.sym.ty);
            store(g, vt, globalRef(g, id.sym), copyV(g, conv(g, load(g, rts[i], gep(g, tv.r, tupleOffset(g, rts, i))), vt)));
        }
        return;
    }
    for (i, id := range names) {
        if (nilS(id.sym) || i >= len(values)) continue;
        vt := sub(g, id.sym.ty);
        v := genAs(g, values[i], vt);
        store(g, vt, globalRef(g, id.sym), conv(g, v, vt));
    }
}

// mainWrapper defines oc_user_main, calling the program's main.
func mainWrapper(g *Gen, main *ast.Symbol) {
    name := funcRef(g, main, make([]*ast.Type));
    ft := main.ty;
    if (len(ft.results) == 1) {
        g.mod.Add("define i64 @oc_user_main() {\nentry:\n  %r = call i64 ").Add(name).Add("(ptr null)\n  ret i64 %r\n}\n\n");
    } else {
        g.mod.Add("define i64 @oc_user_main() {\nentry:\n  call void ").Add(name).Add("(ptr null)\n  ret i64 0\n}\n\n");
    }
}

func setArgsWrapper(g *Gen, s *ast.Symbol) {
    if (nilS(s)) { g.mod.Add("define void @oc_set_args(ptr %s, i64 %n) {\nentry:\n  ret void\n}\n\n"); return; }
    name := funcRef(g, s, make([]*ast.Type));
    g.mod.Add("define void @oc_set_args(ptr %s, i64 %n) {\nentry:\n  call void ").Add(name).Add("(ptr null, ptr %s, i64 %n)\n  ret void\n}\n\n");
}

func drain(g *Gen) {
    for (;;) {
        progress := false;
        for (g.qpos < len(g.queue)) {
            inst := g.queue[g.qpos];
            g.qpos++;
            emitInst(g, inst);
            progress = true;
        }
        if (g.descDone < len(g.descTypes)) { emitPendingDescs(g); progress = true; }
        if (!progress) break;
    }
}

struct Options { library bool; usesThreads bool; wasm bool; }
struct Output { IR string; Ok bool; UsesFFI bool; UsesCurl bool; }

// Generate produces a complete LLVM module for the checked program.
func Generate(c *check.Checker, packages []*ast.Package, root *ast.Package, opts Options) (string, bool) {
    res := GenerateOutput(c, packages, root, opts);
    return res.IR, res.Ok;
}

func GenerateOutput(c *check.Checker, packages []*ast.Package, root *ast.Package, opts Options) Output {
    g := NewGen(c);
    g.library = opts.library;
    g.usesThreads = opts.usesThreads;
    g.wasm = opts.wasm;
    // the string descriptor is referenced by the runtime
    desc(g, check.TString());
    for (_, p := range packages) {
        for (_, s := range p.syms) {
            if (s.kind == ast.SK.Var) globalDef(g, s);
        }
    }
    if (!opts.library) {
        m := root.scope.LookupLocal("main");
        if (!nilS(m) && m.kind == ast.SK.Func) mainWrapper(g, m);
        setArgsWrapper(g, c.OsSetArgs());
        // Pass (argc, argv) on all non-Wasm platforms so musl Linux works without glibc constructor args.
        if (g.wasm) g.mod.Add("declare i32 @oc_start()\ndefine i32 @main() {\nentry:\n  %r = call i32 @oc_start()\n  ret i32 %r\n}\n\n");
        else g.mod.Add("@oc_argc = external global i32\n@oc_argv = external global ptr\ndeclare i32 @oc_start()\ndefine i32 @main(i32 %argc, ptr %argv) {\nentry:\n  store i32 %argc, ptr @oc_argc\n  store ptr %argv, ptr @oc_argv\n  %r = call i32 @oc_start()\n  ret i32 %r\n}\n\n");
    } else {
        for (_, p := range packages) {
            if (p != root) continue;
            for (_, s := range p.syms) {
                if (s.kind == ast.SK.Func && len(s.typeParams) == 0) funcRef(g, s, make([]*ast.Type));
                if (s.kind == ast.SK.Struct || s.kind == ast.SK.Enum || s.kind == ast.SK.TypeDef) {
                    for (_, m := range s.methodList) {
                        if (len(m.typeParams) == 0 && len(s.typeParams) == 0) methodRef(g, m, s.self, make([]*ast.Type));
                    }
                }
            }
        }
    }
    if (!g.usesThreads) {
        // Mach-O and COFF do not resolve optional ELF-style weak imports.
        // Supply the single-thread behavior in the emitted Ocean module.
        declare(g, "@\"exit\"", "declare void @\"exit\"(i32)");
        g.mod.Add("define void @ocean_threads_panic_exit(i32 %code) { ret void }\n");
        g.mod.Add("define void @ocean_threads_begin_return() { ret void }\n");
        g.mod.Add("define void @ocean_threads_exit() noreturn { call void @\"exit\"(i32 0)\n unreachable }\n");
    }
    initFunction(g, packages);
    drain(g);
    emitGenericMethods(g);
    drain(g);
    emitMatchers(g);
    drain(g);
    out := util.NewBuf();
    out.Add("; Ocean program module\n");
    if (!g.wasm && targetTriple() != "") out.Add("target triple = \"").Add(targetTriple()).Add("\"\n");
    if (g.wasm) {
        out.Add("target datalayout = \"e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128-ni:1:10:20\"\n");
        out.Add("target triple = \"wasm32-unknown-unknown\"\n");
    }
    decls := runtimeDecls();
    // WebAssembly (without the threads proposal) has no thread-local storage.
    if (g.wasm) decls = strings.ReplaceAll(decls, "external thread_local global", "external global");
    out.Add(decls);
    if (g.usesThreads) out.Add(threadDecls());
    for (_, name := range g.declOrder) out.Add(g.decls[name]).Add("\n");
    out.Add("@oc_sites = constant [").AddInt(g.nsites).Add(" x {ptr, i64, i64, ptr}] [{ptr, i64, i64, ptr} zeroinitializer").AddBuf(g.sites).Add("]\n");
    out.Add("@oc_nsites = constant i64 ").AddInt(g.nsites).Add("\n");
    out.AddBuf(g.globals);
    out.AddBuf(g.mod);
    res: Output;
    res.IR = out.String();
    res.Ok = g.errors == 0;
    res.UsesFFI = g.usesFFI;
    res.UsesCurl = g.usesCurl;
    return res;
}

// emitGenericMethods registers, for every boxed type with a matching generic
// method, the thunks of the instantiations used by interface calls; oc_method
// consults @oc_generic_methods when a type's own table has no entry.
func emitGenericMethods(g *Gen) {
    entries := make([]string);
    done := 0;
    for (;;) {
        entries = make([]string);
        for (_, gc := range g.genericCalls) {
            for (_, t := range g.descTypes) {
                if (!concreteBoxable(t)) continue;
                base := t; ptr := false;
                if (t.kind == ast.TK.Ptr) { base = t.elem; ptr = true; }
                if (base.kind != ast.TK.Struct && base.kind != ast.TK.Enum && base.kind != ast.TK.Named) continue;
                if (nilS(base.sym)) continue;
                for (_, m := range base.sym.methodList) {
                    if (m.name != gc.method || len(m.typeParams) != len(gc.targs) || (m.recvPtr && !ptr)) continue;
                    th := genericThunkFor(g, m, base, ptr, gc.targs);
                    entries.append("{ptr, ptr, ptr} {ptr " + desc(g, t) + ", ptr " + methodName(g, gc.dispatch) + ", ptr " + th + "}");
                }
            }
        }
        drain(g);
        if (len(entries) == done && g.qpos == len(g.queue)) break;
        done = len(entries);
    }
    g.globals.Add("@oc_generic_method_count = constant i64 ").AddInt(len(entries)).Add("\n");
    if (len(entries) == 0) { g.globals.Add("@oc_generic_methods = constant [0 x {ptr, ptr, ptr}] zeroinitializer\n"); return; }
    g.globals.Add("@oc_generic_methods = constant [").AddInt(len(entries)).Add(" x {ptr, ptr, ptr}] [").Add(strings.Join(entries, ", ")).Add("]\n");
}
