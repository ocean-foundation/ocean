package diag;
import "github.com/ocean-foundation/ocean/compiler/util";
import "strconv";

// Diagnostic is one compiler message, reported in ocean-c's format:
// [file:line:col]: phase severity: message, then a source snippet.
struct Diagnostic {
    file string;
    line int;
    col int;
    phase string;
    severity string;
    message string;
}

struct List {
    items []*Diagnostic;
    errors int;
    warnings int;
    sources map[string]string;
    // When live is set, diagnostics are written to stderr as they arrive.
    live bool;
}

func NewList() *List { l := new(List); l.live = true; return l; }

func (l *List) AddSource(file string, text string) { l.sources[file] = text; }

func (l *List) Report(file string, line int, col int, phase string, severity string, message string) {
    d := new(Diagnostic);
    d.file = file; d.line = line; d.col = col; d.phase = phase; d.severity = severity; d.message = message;
    l.items.append(d);
    if (severity == "warning") l.warnings++; else l.errors++;
    if (l.live) util.Stderr(l.Format(d));
}

func (l *List) Error(file string, line int, col int, phase string, message string) { l.Report(file, line, col, phase, "error", message); }
func (l *List) Warning(file string, line int, col int, phase string, message string) { l.Report(file, line, col, phase, "warning", message); }

func useColor() bool {
    _, no := util.Getenv("NO_COLOR");
    if (no) return false;
    force, ok := util.Getenv("CLICOLOR_FORCE");
    if (ok && force != "" && force != "0") return true;
    return util.IsTerminal(2);
}

func appendSanitized(b *util.Buf, s string, keepTab bool) {
    limit := len(s);
    i := 0;
    for (i < limit) {
        v := (s[i] -> int) & 255;
        if (v < 32) {
            if (keepTab && v == 9) b.Addc('\t');
            else b.Add("\\x").Addc(util.HexDigit(v >> 4)).Addc(util.HexDigit(v & 15));
            i++;
            continue;
        }
        if (v == 127) { b.Add("\\x7f"); i++; continue; }
        if (v == 194 && i + 1 < limit) {
            v2 := (s[i + 1] -> int) & 255;
            if (v2 >= 128 && v2 <= 159) {
                b.Add("\\u00").Addc(util.HexDigit(v2 >> 4)).Addc(util.HexDigit(v2 & 15));
                i += 2;
                continue;
            }
        }
        b.Addc(s[i]);
        i++;
    }
}

func (l *List) Format(d *Diagnostic) string {
    b: util.Buf;
    color := useColor();
    if (color) b.Add(d.severity == "warning" ? "\x1b[33m" : "\x1b[31m");
    line := d.line > 0 ? d.line : 1;
    col := d.col > 0 ? d.col : 1;
    b.Add("[");
    appendSanitized(&b, d.file == "" ? "<source>" : d.file, false);
    b.Add(":").AddInt(line).Add(":").AddInt(col).Add("]: ");
    appendSanitized(&b, d.phase, false);
    b.Add(" ");
    appendSanitized(&b, d.severity, false);
    b.Add(": ");
    appendSanitized(&b, d.message, false);
    b.Add("\n");
    text, ok := l.sources[d.file];
    if (ok) b.Add(Snippet(text, line, col));
    if (color) b.Add("\x1b[0m");
    return b.String();
}

// sanitizedStep returns (byteLen, charWidth) for the next sanitized unit in text[pos:end].
func sanitizedStep(text string, pos int, end int) (int, int) {
    v := (text[pos] -> int) & 255;
    if (v == 9) return 1, 1;
    if (v < 32 || v == 127) return 1, 4;
    if (v == 194 && pos + 1 < end) {
        v2 := (text[pos + 1] -> int) & 255;
        if (v2 >= 128 && v2 <= 159) return 2, 6;
    }
    if (v < 128) return 1, 1;
    if (v >= 194 && v <= 223 && pos + 1 < end && (((text[pos + 1] -> int) & 192) == 128)) return 2, 1;
    if (v >= 224 && v <= 239 && pos + 2 < end && (((text[pos + 1] -> int) & 192) == 128) && (((text[pos + 2] -> int) & 192) == 128)) return 3, 1;
    if (v >= 240 && v <= 244 && pos + 3 < end && (((text[pos + 1] -> int) & 192) == 128) && (((text[pos + 2] -> int) & 192) == 128) && (((text[pos + 3] -> int) & 192) == 128)) return 4, 1;
    return 1, 1;
}

// Snippet renders " N | source line" and a caret line.
func Snippet(text string, line int, col int) string {
    start := 0;
    for (n := 1; n < line; n++) {
        i := start;
        for (i < len(text) && text[i] != '\n') i++;
        if (i >= len(text)) return "";
        start = i + 1;
    }
    end := start;
    for (end < len(text) && text[end] != '\n' && text[end] != '\r') end++;
    lineStart := start;
    lineEnd := end;
    caretPos := lineStart + col - 1;
    if (caretPos < lineStart) caretPos = lineStart;
    if (caretPos > lineEnd) caretPos = lineEnd;

    totalWidth := 0;
    caretWidth := 0;
    for (p := lineStart; p < lineEnd; ) {
        bl, cw := sanitizedStep(text, p, lineEnd);
        if (p < caretPos) caretWidth += cw;
        totalWidth += cw;
        p += bl;
    }

    b: util.Buf;
    prefix := " " + strconv.Itoa(line) + " | ";
    b.Add(prefix);
    maxSnippet := 80;
    truncated := totalWidth > maxSnippet;
    leftTruncated := truncated && caretWidth >= 50;
    if (leftTruncated) { // left truncate if the error is far into the line
        targetSkip := caretWidth - 46;
        maxSkip := totalWidth - (maxSnippet - 3);
        if (targetSkip > maxSkip) targetSkip = maxSkip;
        skipped := 0;
        for (start < lineEnd && skipped < targetSkip) {
            bl, cw := sanitizedStep(text, start, lineEnd);
            start += bl;
            skipped += cw;
        }
        b.Add("...");
        truncated = totalWidth - skipped > maxSnippet - 3; // recheck if right truncation is needed after left truncation
    }
    if (truncated) {
        budget := maxSnippet - 3 - (leftTruncated ? 3 : 0);
        w := 0;
        p := start;
        for (p < lineEnd) {
            bl, cw := sanitizedStep(text, p, lineEnd);
            if (w + cw > budget) break;
            w += cw;
            p += bl;
        }
        end = p;
    }
    appendSanitized(&b, text[start:end], true);
    if (truncated) b.Add("...");
    b.Add("\n");
    for (i := 0; i < len(prefix); i++) b.Addc(prefix[i] == '|' ? '|'->i8 : ' '->i8);
    if (leftTruncated) b.Add("   ");
    caret := caretPos - start;
    if (caret < 0) caret = 0;
    if (caret > end - start) caret = end - start;
    i := 0;
    for (i < caret) {
        v := (text[start + i] -> int) & 255;
        if (v == 9) { b.Addc('\t'); i++; continue; }
        bl, cw := sanitizedStep(text, start + i, end);
        for (k := 0; k < cw; k++) b.Addc(' ');
        i += bl;
    }
    b.Add("^\n");
    return b.String();
}
