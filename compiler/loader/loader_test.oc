package loader;
import "testing";
import "github.com/ocean-foundation/ocean/compiler/diag";
import "github.com/ocean-foundation/ocean/compiler/util";
import "path" as filepath;
import "strings";

func quiet() *diag.List { d := diag.NewList(); d.live = false; return d; }

func writeTree(t *testing.T, files []string) string {
    dir, ok := util.MakeTempDir("ocean-loader-test-");
    if (!ok) t.Fatal("tempdir");
    real, _ := util.Realpath(dir);
    for (i := 0; i + 1 < len(files); i += 2) {
        path := real + "/" + files[i];
        util.MkdirAll(filepath.Dir(path));
        util.WriteFile(path, files[i + 1]);
    }
    return real;
}

func TestModuleResolution(t *testing.T) {
    root := writeTree(t, []string{
        "ocean.mod", "module example.com/app\n\nocean 0.1\nrequire (\n  example.com/lib v1.0.0 // comment\n)\nreplace example.com/lib => ./vendored\n",
        "main.oc", "package main; import \"example.com/app/helper\"; import \"io\"; import h2 \"helper\"; import \"example.com/lib/sub\"; func main() {}",
        "helper/a.oc", "package helper; func A() int { return 1; }",
        "helper/b_native.oc", "package helper;",
        "helper/c_wasm.oc", "package other;",
        "helper/x_test.oc", "package helper;",
        "vendored/ocean.mod", "module example.com/lib\n",
        "vendored/sub/s.oc", "package sub;"});
    b := NewBuild(quiet());
    ok := b.LoadPackage(root);
    if (!ok) { t.Fatal("load failed: ", b.diags.items[0].message); }
    if (b.root.name != "main" || b.isLibrary) t.Error("root");
    names := "";
    for (_, p := range b.order) names += p.name + " ";
    if (!strings.Contains(names, "helper") || !strings.Contains(names, "io") || !strings.Contains(names, "sub")) t.Error("order: ", names);
    for (_, p := range b.packages) {
        if (p.name == "helper" && len(p.files) != 2) t.Error("helper files ", len(p.files));
        if (p.name == "io" && !p.std) t.Error("io std");
    }
    if (len(b.root.files[0].importNodes) != 4 || b.root.files[0].importNodes[2].name != "h2") t.Error("imports");
    util.RemoveAll(root);
}

func TestErrors(t *testing.T) {
    root := writeTree(t, []string{
        "ocean.mod", "module m\n",
        "a/a.oc", "package a; import \"m/b\";",
        "b/b.oc", "package b; import \"m/a\";",
        "c/c.oc", "package c;", "c/d.oc", "package d;",
        "e/e.oc", "package e; import \"nowhere/x\";"});
    d := quiet();
    b := NewBuild(d);
    if (b.LoadPackage(root + "/a")) t.Error("cycle accepted");
    if (d.items[0].message != "import cycle") t.Error("cycle msg ", d.items[0].message);
    d2 := quiet();
    if (NewBuild(d2).LoadPackage(root + "/c")) t.Error("conflict accepted");
    if (d2.items[0].message != "package d conflicts with package c") t.Error("conflict msg ", d2.items[0].message);
    d3 := quiet();
    if (NewBuild(d3).LoadPackage(root + "/e")) t.Error("missing accepted");
    if (d3.items[0].message != "package not found: nowhere/x") t.Error("missing msg ", d3.items[0].message);
    util.RemoveAll(root);
}

func TestTestHarness(t *testing.T) {
    root := writeTree(t, []string{
        "ocean.mod", "module m\n",
        "p/p.oc", "package p; func Add(a, b int) int { return a + b; }",
        "p/p_test.oc", "package p; import \"testing\"; func TestAdd(t *testing.T) {} func helper() {}",
        "p/ext_test.oc", "package p_test; import \"testing\"; import \"m/p\"; func TestExt(t *testing.T) {}"});
    b := NewBuild(quiet());
    if (!b.HasTestSources(root + "/p")) t.Error("has tests");
    ok := b.LoadTestPackage(root + "/p", root + "/.harness");
    if (!ok) { t.Fatal("load failed: ", b.diags.items[0].message); }
    text := b.root.files[0].text;
    if (!strings.Contains(text, "testing.RunTest(\"TestAdd\", tested.TestAdd);") || !strings.Contains(text, "external.TestExt")) t.Error("harness: ", text);
    util.RemoveAll(root);
}

func TestPaths(t *testing.T) {
    if (!ValidModulePath("github.com/a/b") || ValidModulePath("a//b") || ValidModulePath("../x") || ValidModulePath("a b")) t.Error("valid path");
    cwd := util.Getcwd();
    if (RelativeSourcePath(cwd + "/x/y.oc") != "x/y.oc") t.Error("rel1 ", RelativeSourcePath(cwd + "/x/y.oc"));
    if (RelativeSourcePath("./a.oc") != "a.oc") t.Error("rel2");
    if (RelativeSourcePath(filepath.Dir(cwd) + "/z.oc") != "../z.oc") t.Error("rel3 ", RelativeSourcePath(filepath.Dir(cwd) + "/z.oc"));
    if (!TargetSource("a.oc") || !TargetSource("a_native.oc") || TargetSource("a_wasm_test.oc")) t.Error("target");
}

func TestHarnessIsolatedFromParentOceanMod(t *testing.T) {
    root := writeTree(t, []string{
        "ocean.mod", "module hijacked.example/evil\n",
        "evilpkg/evil.oc", "package evilpkg;",
        "work/mod/ocean.mod", "module example.com/app\n",
        "work/mod/p/p.oc", "package p;",
        "work/mod/p/p_test.oc", "package p; import \"testing\"; func TestOk(t *testing.T) {}"});
    b := NewBuild(quiet());
    ok := b.LoadTestPackage(root + "/work/mod/p", root + "/harness");
    if (!ok) { t.Fatal("load test failed: ", b.diags.items[0].message); }
    if (!b.root.harness) t.Error("expected harness flag on test runner package");
    if (!NilModule(b.root.module)) t.Error("harness must not bind parent ocean.mod");
    // A harness referencing a package outside stdlib/__ocean_test_* must fail.
    b2 := NewBuild(quiet());
    b2.AddOverlay(root + "/harness/runner.oc", "package main; import \"evilpkg\"; func main() int { return 0; }");
    b2.harnessDirectory = root + "/harness";
    b2.LoadPackage(root + "/harness");
    if (b2.errors == 0) t.Error("harness should reject parent-module import");
    util.RemoveAll(root);
}

func TestEmptyReplaceAndSumVerification(t *testing.T) {
    root := writeTree(t, []string{
        "bad/ocean.mod", "module m\nreplace example.com/dep => \"\"\n",
        "bad/main.oc", "package main; import \"example.com/dep\"; func main() {}",
        "cache/example.com/dep@v1.0.0/ocean.mod", "module example.com/dep\nrequire example.com/leaf v2.0.0\n",
        "cache/example.com/dep@v1.0.0/dep.oc", "package dep; import \"example.com/leaf\"; func X() int { return leaf.X(); }",
        "cache/example.com/leaf@v2.0.0/ocean.mod", "module example.com/leaf\n",
        "cache/example.com/leaf@v2.0.0/leaf.oc", "package leaf; func X() int { return 7; }",
        "app/ocean.mod", "module example.com/app\nrequire example.com/dep v1.0.0\n",
        "app/main.oc", "package main; import \"example.com/dep\"; func main() {}"});
    // 1. Empty replace target must be rejected at manifest parse time without panic.
    dBad := quiet();
    bBad := NewBuild(dBad);
    if (bBad.LoadPackage(root + "/bad")) t.Error("empty replace target should fail");

    // 2. Uncached module without ocean.sum must fail without auto-cloning.
    prevCache, hadCache := util.Getenv("OCEAN_MOD_CACHE");
    util.Setenv("OCEAN_MOD_CACHE", root + "/cache");
    dNoSum := quiet();
    if (NewBuild(dNoSum).LoadPackage(root + "/app")) t.Error("missing ocean.sum must fail");

    // 3. The project must pin both modules. The dependency has no ocean.sum.
    digest, hok := util.HashDir(root + "/cache/example.com/dep@v1.0.0");
    if (!hok) t.Fatal("hash failed");
    e: SumEntry; e.module = "example.com/dep"; e.version = "v1.0.0"; e.hash = digest;
    if (!WriteSum(root + "/app", []SumEntry{e})) t.Fatal("write sum failed");
    dMissingLeaf := quiet();
    if (NewBuild(dMissingLeaf).LoadPackage(root + "/app")) t.Error("missing transitive checksum must fail");
    if (len(dMissingLeaf.items) == 0 || !strings.Contains(dMissingLeaf.items[0].message, "example.com/leaf@v2.0.0")) {
        t.Error("expected the missing transitive checksum error");
    }
    leafDigest, leafOK := util.HashDir(root + "/cache/example.com/leaf@v2.0.0");
    if (!leafOK) t.Fatal("leaf hash failed");
    leaf := SumEntry{module: "example.com/leaf", version: "v2.0.0", hash: leafDigest};
    if (!WriteSum(root + "/app", []SumEntry{e, leaf})) t.Fatal("write transitive sum failed");
    dOk := quiet();
    if (!NewBuild(dOk).LoadPackage(root + "/app")) t.Fatal("verified load failed: ", dOk.items[0].message);

    // 4. Tampering with a transitive dependency causes a checksum mismatch.
    util.WriteFile(root + "/cache/example.com/leaf@v2.0.0/leaf.oc", "package leaf; func X() int { return 999; }");
    dTamper := quiet();
    if (NewBuild(dTamper).LoadPackage(root + "/app")) t.Error("tampered cache should fail");
    if (len(dTamper.items) == 0 || !strings.Contains(dTamper.items[0].message, "checksum mismatch")) {
        t.Error("expected checksum mismatch error");
    }

    if (hadCache) util.Setenv("OCEAN_MOD_CACHE", prevCache); else util.Unsetenv("OCEAN_MOD_CACHE");
    util.RemoveAll(root);
}
