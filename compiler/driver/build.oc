package driver;
import "github.com/ocean-foundation/ocean/compiler/loader";
import "github.com/ocean-foundation/ocean/compiler/util";
import "strings";

func loaderValidModulePath(s string) bool { return loader.ValidModulePath(s); }

struct BuildOptions {
    run bool;
    check bool;
    emit bool;
    staticLink bool;
    output string;
    location string;
    programArgs []string;
}

func packageMain(args []string) int {
    o: BuildOptions;
    o.run = args[1] == "run";
    o.check = args[1] == "check";
    argumentStart := len(args);
    for (i := 2; i < len(args); i++) {
        a := args[i];
        if (a == "--") {
            argumentStart = i + 1;
            if (o.run) { for (j := i + 1; j < len(args); j++) o.programArgs.append(args[j]); }
            break;
        }
        if (a == "-o") {
            i++;
            if (i >= len(args)) { util.Stderr("ocean: -o requires an output path\n"); return 1; }
            o.output = args[i];
        } else if (a == "-ldflags" || a == "--ldflags") {
            i++;
            if (i >= len(args)) { util.Stderr("ocean: " + a + " requires a flag string\n"); return 1; }
            if (!loader.SetLinkerFlags(args[i])) { util.Stderr("ocean: invalid -ldflags; expected -X importpath.name=value\n"); return 1; }
        } else if (strings.HasPrefix(a, "-ldflags=") || strings.HasPrefix(a, "--ldflags=")) {
            if (!loader.SetLinkerFlags(a[strings.IndexByte(a, '=') + 1:])) { util.Stderr("ocean: invalid -ldflags; expected -X importpath.name=value\n"); return 1; }
        } else if (a == "--emit-llvm") o.emit = true;
        else if (a == "--check") o.check = true;
        else if (a == "--static" || a == "-s") o.staticLink = true;
        else if (len(a) > 0 && a[0] == '-') {
            if (o.run && o.location != "") { o.programArgs.append(a); continue; }
            util.Stderr("ocean: unknown option: " + a + "\n"); return 1;
        } else if (o.location == "") o.location = a;
        else if (o.run) o.programArgs.append(a);
        else { util.Stderr("ocean build accepts one package location\n"); return 1; }
    }
    if ((o.staticLink && (o.check || o.emit)) || (o.run && (o.output != "" || o.emit || o.check)) ||
        (o.check && (o.output != "" || o.emit)) || (!o.run && argumentStart != len(args))) {
        util.Stderr("ocean: incompatible build/run options\n"); return 1;
    }
    if (o.location == "") o.location = ".";
    return buildPackage(&o);
}

func buildPackage(o *BuildOptions) int {
    if (!validateTarget()) return 1;
    if (o.run && !requireHostTarget("run")) return 1;
    diags := newDiags();
    prog := Frontend(o.location, false, "", diags);
    if (prog.fatal) return 1;
    if (ast_nil(prog)) return 1;
    if (prog.build.Errors() > 0 || prog.name == "") return 1;
    if (o.staticLink && prog.isLibrary) { util.Stderr("ocean: --static requires a main package executable\n"); return 1; }
    if (o.run && prog.isLibrary) { util.Stderr("ocean run: package " + prog.name + " is not main\n"); return 1; }
    if (!prog.ok) return 1;
    if (o.check) {
        failed := checkBackend(prog);
        if (!failed && prog.build.HasTestSources(o.location)) {
            harness, _ := util.MakeTempDir(".ocean-check-harness-");
            tdiags := newDiags();
            tprog := Frontend(o.location, true, harness, tdiags);
            failed = tprog.fatal || !tprog.ok;
            if (!failed) failed = checkBackend(tprog);
            util.RemoveAll(harness);
        }
        return failed ? 1 : 0;
    }
    return emitAndLink(prog, o);
}

func ast_nil(p *Program) bool { return (p -> int) == 0; }
func targetWasm() bool { return util.BuildTarget().Wasm(); }

func validateTarget() bool {
    target := util.BuildTarget();
    if (target.Supported()) return true;
    util.Stderr("ocean: unsupported target OCOS=" + target.system + " OCARCH=" + target.arch + "\n" +
        "Set both variables to a supported pair: linux with x86_64, aarch64 or riscv64; " +
        "macos or windows with x86_64 or aarch64; js with wasm. Unset both to target the host.\n");
    return false;
}

func requireHostTarget(command string) bool {
    target := util.BuildTarget();
    if (target.IsHost()) return true;
    util.Stderr("ocean " + command + ": requires the host target. Use ocean build to produce an artifact for " +
        target.system + "/" + target.arch + ".\n");
    return false;
}
