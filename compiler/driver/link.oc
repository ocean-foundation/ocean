package driver;
import "github.com/ocean-foundation/ocean/compiler/ast";
import "github.com/ocean-foundation/ocean/compiler/diag";
import "github.com/ocean-foundation/ocean/compiler/backend";
import "github.com/ocean-foundation/ocean/compiler/runtime";
import "github.com/ocean-foundation/ocean/compiler/util";
import "os";
import "path" as filepath;
import "strconv";
import "strings";
import "unicode";

func usesPackage(p *Program, path string) bool {
    for (_, pk := range p.checker.Packages()) { if (pk.std && pk.path == path) return true; }
    return false;
}

func generate(p *Program) (string, bool) {
    opts: backend.Options;
    opts.library = p.isLibrary;
    opts.usesThreads = p.checker.UsesThreads();
    opts.wasm = targetWasm();
    ir, ok := backend.Generate(p.checker, p.checker.Packages(), p.build.Root(), opts);
    p.usesFFI = strings.Contains(ir, "@oc_cvar_call(");
    p.usesCurl = strings.Contains(ir, "@\"curl_") || strings.Contains(ir, "@curl_");
    return ir, ok;
}

func optLevel() string {
    o, ok := util.Getenv("OCEAN_OPT");
    if (ok && o != "") return "-O" + o;
    return "-O1";
}

// runtimeSources writes the runtime C files needed by a program into dir.
func runtimeSources(p *Program, dir string) []string {
    files := make([]string);
    core := dir + "/ocean_core.c";
    util.WriteFile(core, runtime.Core());
    files.append(core);
    if (targetWasm()) {
        // freestanding libc subset: header shims plus their implementation
        util.WriteFile(dir + "/ocean_wasm.h", runtime.Wasm());
        for (_, h := range []string{"stdlib.h", "stdio.h", "string.h", "setjmp.h", "unistd.h"}) util.WriteFile(dir + "/" + h, "#include \"ocean_wasm.h\"\n");
        libc := dir + "/ocean_wasm.c";
        util.WriteFile(libc, "#define OCEAN_WASM_IMPL\n#include \"ocean_wasm.h\"\n");
        files.append(libc);
        return files;
    }
    if (p.checker.UsesThreads()) {
        th := dir + "/ocean_threads.c";
        util.WriteFile(th, runtime.Threads());
        files.append(th);
    }
    if (p.usesFFI) {
        ff := dir + "/ocean_ffi.c";
        util.WriteFile(ff, runtime.Ffi());
        files.append(ff);
    }
    if (usesPackage(p, "os/exec")) {
        pr := dir + "/ocean_process.c";
        util.WriteFile(pr, runtime.Process());
        files.append(pr);
    }
    return files;
}

// clangArgs applies the same target and sysroot to IR, runtime C, and linking.
func clangArgs(options []string) []string {
    args := clangTargetArgs(util.BuildTarget());
    args.append(options...);
    return args;
}

func clangTargetArgs(target util.Target) []string {
    root := managedTargetRoot(target);
    args := make([]string);
    if (root != "") {
        path := targetPath(root, target);
        sdk, _ := util.ReadFile(path + "/sdk");
        args = managedClangArgs(root, target, path, sdk);
    } else {
        clang, _ := util.Getenv("OCEAN_CLANG");
        args.append(clang == "" ? "clang" : clang);
        triple := target.Triple();
        if (triple != "") args.append("--target=" + triple);
        sysroot, _ := util.Getenv("OCEAN_SYSROOT");
        if (sysroot != "" && !target.Wasm()) args.append("--sysroot=" + sysroot);
    }
    if (target.system == "windows") args.append("-D_longjmp=longjmp", "-D__USE_MINGW_SETJMP_NON_SEH");
    return args;
}

func ffiCompileFlags(target util.Target) []string {
    flags, ok := targetPackageFlags(target, "libffi", "--cflags");
    if (ok) return flags;
    if (target.system == "macos") return []string{"-iwithsysroot", "/usr/include/ffi"};
    return make([]string);
}

func clangRun(p *Program, args []string) bool {
    target := util.BuildTarget();
    for (_, arg := range args) {
        if (strings.HasSuffix(arg, "/ocean_ffi.c")) {
            args.append(ffiCompileFlags(target)...);
            break;
        }
    }
    st, out := util.RunCapture(args.array());
    if (!st.Failed && st.Code == 0) return true;
    if (out != "") util.Stderr(out);
    util.Stderr("backend error: " + args[0] + " failed for " + target.system + "/" + target.arch + "\n");
    if (args[0] == "llvm-ar" || strings.HasSuffix(args[0], "/llvm-ar" + os.ExeSuffix())) {
        util.Stderr("Install LLVM and put llvm-ar on PATH to create Windows library archives.\n");
        return false;
    }
    if (target.explicit && managedTargetRoot(target) == "")
        util.Stderr("Install managed components with ocean target " + target.Name() + ".\n");
    util.Stderr("Install Clang with support for the target and put it on PATH, or set OCEAN_CLANG to its executable.\n");
    if (target.Wasm()) {
        util.Stderr("Install LLD for WebAssembly and make wasm-ld available to Clang.\n");
        return false;
    }
    if (target.system == "linux")
        util.Stderr("Install a Linux linker, libc headers, startup objects and runtime libraries for " + target.arch + ". Set OCEAN_SYSROOT if the target files are in a separate sysroot.\n");
    else if (target.system == "macos")
        util.Stderr("Install the Xcode Command Line Tools on macOS, or provide a macOS SDK via OCEAN_SYSROOT and a Mach-O linker.\n");
    else if (target.system == "windows")
        util.Stderr("Install a MinGW-w64 toolchain for " + target.arch + ", such as LLVM-MinGW, and point OCEAN_CLANG to its Clang.\n");
    if (p.usesFFI) util.Stderr("Install libffi headers and libraries for the target.\n");
    if (p.usesCurl) util.Stderr("Install libcurl development libraries for the target.\n");
    if (!target.IsHost() && (p.usesFFI || p.usesCurl))
        util.Stderr("For target pkg-config files, set PKG_CONFIG_LIBDIR and, for a separate sysroot, PKG_CONFIG_SYSROOT_DIR.\n");
    return false;
}

// compileProgram produces an executable or relocatable object at output.
// With a build cache the compiled program object is cached (independent of
// static linking) and the final link always runs.
func compileProgram(p *Program, ir string, output string, staticLink bool) bool {
    target := util.BuildTarget();
    clang, _ := util.Getenv("OCEAN_CLANG");
    sysroot, _ := util.Getenv("OCEAN_SYSROOT");
    if (target.explicit || clang != "" || sysroot != "") return compileUncached(p, ir, output, staticLink);
    root := cacheRoot();
    if (p.isLibrary) {
        key := cacheKey(p, ir, staticLink);
        if (cacheLookup(key, output)) return true;
        if (!compileUncached(p, ir, output, staticLink)) return false;
        cacheStore(key, output);
        return true;
    }
    if (root == "") return compileUncached(p, ir, output, staticLink);
    key := cacheKey(p, ir, false) + ".o";
    dir, ok := util.MakeTempDir("ocean-build-");
    if (!ok) { util.Stderr("ocean: cannot create temporary directory\n"); return false; }
    obj := dir + "/program.o";
    if (!cacheLookup(key, obj)) {
        irPath := dir + "/program.ll";
        if (!util.WriteFile(irPath, ir)) { util.Stderr("ocean: could not create IR file\n"); util.RemoveAll(dir); return false; }
        parts := make([]string);
        all := make([]string);
        all.append(irPath);
        all.append(runtimeSources(p, dir)...);
        for (i, f := range all) {
            o := dir + "/part" + strconv.Itoa(i) + ".o";
            cargs := clangArgs([]string{optLevel(), "-w", "-Wno-override-module", "-c"});
            if (strings.HasSuffix(f, ".ll")) cargs.append("-x", "ir"); else cargs.append("-x", "c");
            cargs.append(f, "-o", o);
            if (!clangRun(p, cargs)) { util.RemoveAll(dir); return false; }
            parts.append(o);
        }
        if (len(parts) == 1) util.Rename(parts[0], obj);
        else {
            rargs := objectLinkArgs(obj);
            rargs.append(parts...);
            if (!clangRun(p, rargs)) { util.RemoveAll(dir); return false; }
        }
        cacheStore(key, obj);
    }
    staged := output + ".ocean-tmp" + (p.isLibrary ? "" : os.ExeSuffix());
    if (!util.CreateOutput(staged)) { util.Stderr("could not create output: " + util.OutputError(staged, false) + "\n"); util.RemoveAll(dir); return false; }
    args := clangArgs([]string{obj, "-o", staged});
    if (!appendLinkFlags(p, &args, staticLink)) { util.RemoveAll(dir); util.Remove(staged); return false; }
    ok2 := clangRun(p, args);
    util.RemoveAll(dir);
    if (!ok2) { util.Remove(staged); return false; }
    if (!util.Rename(staged, output)) { util.Stderr("could not save output: " + util.OutputError(output, true) + "\n"); util.Remove(staged); return false; }
    return true;
}

// appendLinkFlags adds the system libraries and static flags of a final link.
func appendLinkFlags(p *Program, args *[]string, staticLink bool) bool {
    target := util.BuildTarget();
    windows := target.system == "windows";
    if (p.checker.UsesThreads() && !windows) (*args).append("-pthread");
    if (windows) {
        (*args).append("-Wl,--stack,8388608");
        if (usesPackage(p, "os/exec")) (*args).append("-lshell32");
    }
    if (!appendDependencyLinkFlags(target, args, p.usesFFI, p.usesCurl, staticLink)) return false;
    if (staticLink) (*args).append("-static");
    return true;
}

func appendDependencyLinkFlags(target util.Target, args *[]string, ffi bool, curl bool, staticLink bool) bool {
    if (ffi) {
        flags, ok := targetPackageFlags(target, "libffi", "--libs");
        if (ok) (*args).append(flags...); else (*args).append("-lffi");
    }
    if (curl && !target.Wasm()) {
        if (staticLink) {
            flags, fok := targetPackageFlags(target, "libcurl", "--static", "--libs");
            if (!fok) { util.Stderr("backend error: static HTTP linking requires pkg-config and the target libcurl static development dependencies (set PKG_CONFIG_LIBDIR for cross builds)\n"); return false; }
            (*args).append(flags...);
        } else {
            flags := []string{"-lcurl"};
            if (!target.IsHost()) {
                targetFlags, ok := targetPackageFlags(target, "libcurl", "--libs");
                if (ok && len(targetFlags) > 0) flags = targetFlags;
            }
            (*args).append(flags...);
        }
    }
    return true;
}

func compileUncached(p *Program, ir string, output string, staticLink bool) bool {
    dir, ok := util.MakeTempDir("ocean-build-");
    if (!ok) { util.Stderr("ocean: cannot create temporary directory\n"); return false; }
    irPath := dir + "/program.ll";
    if (!util.WriteFile(irPath, ir)) { util.Stderr("ocean: could not create IR file\n"); util.RemoveAll(dir); return false; }
    if (targetWasm() && (p.checker.UsesThreads() || p.usesFFI || usesPackage(p, "os/exec"))) {
        util.Stderr(p.checker.UsesThreads() ? "backend error: threads and sync are unavailable on WebAssembly\n" : p.usesFFI ? "backend error: C variadic calls are unavailable on WebAssembly\n" : "backend error: native processes are unavailable on WebAssembly\n");
        util.RemoveAll(dir); return false;
    }
    rts := runtimeSources(p, dir);
    staged := output + ".ocean-tmp" + (p.isLibrary ? "" : util.BuildTarget().ExeSuffix());
    if (!util.CreateOutput(staged)) { util.Stderr("could not create output: " + util.OutputError(staged, false) + "\n"); util.RemoveAll(dir); return false; }
    args := clangArgs([]string{optLevel(), "-w", "-Wno-override-module"});
    if (targetWasm()) {
        args = clangArgs([]string{"-O1", "-w", "-Wno-override-module"});
        args.append(wasmCompileFlags(dir)...);
        if (!p.isLibrary) args.append("-nostdlib", "-Wl,--no-entry", "-Wl,--export=main", "-Wl,--allow-undefined", "-Wl,--gc-sections");
    }
    if (p.isLibrary) {
        objs := make([]string);
        all := make([]string);
        all.append(irPath);
        all.append(rts...);
        for (i, f := range all) {
            obj := dir + "/part" + strconv.Itoa(i) + ".o";
            cargs := clangArgs([]string{optLevel(), "-w", "-Wno-override-module", "-ffunction-sections", "-fdata-sections", "-DOC_LIBRARY", "-c"});
            if (targetWasm()) cargs.append(wasmCompileFlags(dir)...);
            if (strings.HasSuffix(f, ".ll")) cargs.append("-x", "ir");
            else cargs.append("-x", "c");
            cargs.append(f, "-o", obj);
            if (!clangRun(p, cargs)) { util.RemoveAll(dir); util.Remove(staged); return false; }
            objs.append(obj);
        }
        largs := objectLinkArgs(staged);
        largs.append(objs...);
        if (!clangRun(p, largs)) { util.RemoveAll(dir); util.Remove(staged); return false; }
    } else {
        args.append("-x", "ir", irPath, "-x", "c");
        args.append(rts...);
        args.append("-o", staged);
        if (!targetWasm() && !appendLinkFlags(p, &args, staticLink)) { util.RemoveAll(dir); util.Remove(staged); return false; }
        if (!clangRun(p, args)) { util.RemoveAll(dir); util.Remove(staged); return false; }
    }
    util.RemoveAll(dir);
    if (!util.Rename(staged, output)) { util.Stderr("could not save output: " + util.OutputError(output, true) + "\n"); util.Remove(staged); return false; }
    return true;
}

// selfContainedIR merges the runtime into the program module for --emit-llvm.
// selfContainedIR appends the runtime, compiled to assembly, as module-level
// inline asm: the program IR is emitted untouched (no llvm-link round trip,
// which re-prints wide constants in decimal), yet clang can build it alone.
func selfContainedIR(p *Program, ir string) (string, bool) {
    if (util.BuildTarget().explicit) return ir, true; // selected targets emit program IR only
    dir, ok := util.MakeTempDir("ocean-ir-");
    if (!ok) { util.Stderr("ocean: cannot create temporary directory for runtime IR\n"); return "", false; }
    out: util.Buf;
    out.Add(ir);
    if (!strings.HasSuffix(ir, "\n")) out.Add("\n");
    for (i, f := range runtimeSources(p, dir)) {
        asmPath := dir + "/rt" + strconv.Itoa(i) + ".s";
        if (!clangRun(p, clangArgs([]string{optLevel(), "-w", "-S", "-g0", "-fno-asynchronous-unwind-tables", "-x", "c", f, "-o", asmPath}))) { util.RemoveAll(dir); return "", false; }
        text, rok := util.ReadFile(asmPath);
        if (!rok) { util.Stderr("ocean: could not read runtime assembly\n"); util.RemoveAll(dir); return "", false; }
        start := 0;
        for (k := 0; k <= len(text); k++) {
            if (k < len(text) && text[k] != '\n') continue;
            line := text[start:k];
            start = k + 1;
            if (line == "" || strings.HasPrefix(strings.TrimSpace(line), ".addrsig") || strings.HasPrefix(strings.TrimSpace(line), ".ident")) continue;
            out.Add("module asm \"");
            for (c := 0; c < len(line); c++) {
                ch := line[c];
                // local labels are renamed per unit so they cannot collide
                if (ch == '.' && c + 1 < len(line) && line[c + 1] == 'L' && (c == 0 || !labelChar(line[c - 1]))) {
                    out.Add(".Locrt").Add(strconv.Itoa(i)).Add("_");
                    c++;
                    continue;
                }
                v := (ch -> int) & 255;
                if (ch == '"' || ch == '\\' || v < 32 || v > 126) { out.Addc('\\'); out.Addc(util.HexDigit(v >> 4)); out.Addc(util.HexDigit(v)); }
                else out.Addc(ch);
            }
            out.Add("\"\n");
        }
    }
    util.RemoveAll(dir);
    return out.String(), true;
}

func checkBackend(p *Program) bool {
    ir, ok := generate(p);
    if (!ok) return true;
    dir, dok := util.MakeTempDir("ocean-check-");
    if (!dok) return true;
    out := dir + "/check.out";
    built := compileUncached(p, ir, out, false);
    util.RemoveAll(dir);
    return !built;
}

func emitAndLink(p *Program, o *BuildOptions) int {
    ir, ok := generate(p);
    if (!ok) return 1;
    if (o.emit) {
        out := o.output == "" ? "a.ll" : o.output;
        full, emitted := selfContainedIR(p, ir);
        if (!emitted) return 1;
        if (!util.WriteFile(out, full)) { util.Stderr("ocean: could not save IR\n"); return 1; }
        return 0;
    }
    if (o.run) {
        dir, dok := util.MakeTempDir(".ocean-run-");
        if (!dok) { util.Stderr("ocean run: temporary directory\n"); return 1; }
        exe := dir + "/program" + os.ExeSuffix();
        if (!compileProgram(p, ir, exe, o.staticLink)) { util.RemoveAll(dir); return 1; }
        argv := make([]string);
        argv.append(exe);
        argv.append(o.programArgs...);
        st := util.RunForeground(argv.array());
        util.RemoveAll(dir);
        if (st.Signal > 0) util.Stderr("ocean run: program terminated by signal " + strconv.Itoa(st.Signal) + " (" + util.SignalName(st.Signal) + ")\n");
        return st.Code;
    }
    out := o.output;
    if (out == "") {
        if (p.isLibrary) out = p.name + ".o";
        else { b := filepath.Base(p.dir); out = (b == "" ? "main" : b) + util.BuildTarget().ExeSuffix(); }
    }
    for (_, pk := range p.checker.Packages()) {
        for (_, src := range pk.files) {
            if (src.abs != "" && sameFile(out, src.abs)) { util.Stderr("ocean: output would overwrite an input file\n"); return 1; }
        }
    }
    return compileProgram(p, ir, out, o.staticLink) ? 0 : 1;
}

func sameFile(a string, b string) bool {
    x, ok1 := util.Realpath(a);
    y, ok2 := util.Realpath(b);
    return ok1 && ok2 && x == y;
}

func unusedAst(p *ast.Package) bool { return (p -> int) == 0; }

func Generate(p *Program) (string, bool) { return generate(p); }
func NewDiagsQuiet() *diag.List { d := newDiags(); return d; }

func labelChar(ch i8) bool { return unicode.IsLetter(ch) || unicode.IsDigit(ch) || ch == '_' || ch == '.' || ch == '$'; }

// wasmCompileFlags selects the freestanding runtime headers in dir.
func wasmCompileFlags(dir string) []string {
    return []string{"-I" + dir, "-D__thread=", "-ffunction-sections", "-fdata-sections"};
}

// COFF libraries are indexed archives. Mach-O relocatable links must retain
// private externals referenced by other cached objects.
func objectLinkArgs(output string) []string {
    target := util.BuildTarget();
    if (target.system == "windows") {
        return []string{targetTool(managedTargetRoot(target), "llvm-ar"), "rcs", output};
    }
    args := clangArgs([]string{"-r", "-nostdlib", "-o", output});
    if (target.system == "macos") args.append("-Wl,-keep_private_externs");
    return args;
}

func targetPackageFlags(target util.Target, packageName string, options ...string) ([]string, bool) {
    // Managed bundles supply target headers and libraries directly to Clang.
    // Static curl still needs pkg-config to describe its dependency closure.
    if (managedTargetRoot(target) != "" && options[0] != "--static") return make([]string), false;
    if (!target.IsHost()) {
        libdir, _ := util.Getenv("PKG_CONFIG_LIBDIR");
        if (libdir == "") return make([]string), false;
    }
    args := []string{"pkg-config"};
    args.append(options...);
    args.append(packageName);
    st, text := util.RunCapture(args.array());
    out := make([]string);
    if (st.Failed || st.Code != 0) return out, false;
    word := ""; quote: i8 = 0; escaped := false;
    for (i := 0; i < len(text); i++) {
        c := text[i];
        if (escaped) { word += c; escaped = false; continue; }
        if (c == '\\' && quote != '\'') { escaped = true; continue; }
        if (quote != 0) { if (c == quote) quote = 0; else word += c; continue; }
        if (c == '\'' || c == '"') { quote = c; continue; }
        if (c == ' ' || c == '\n' || c == '\t' || c == '\r') { if (word != "") out.append(word); word = ""; }
        else word += c;
    }
    if (quote != 0 || escaped) return out, false;
    if (word != "") out.append(word);
    return out, true;
}
