package driver;

import "github.com/ocean-foundation/ocean/compiler/util";
import "os";
import "strconv";
import "strings";

func targetUsage() string {
    return "Usage: ocean target --list | ocean target --sets\n" +
        "       ocean target [--force] [--<set>...] [target...]\n" +
        "       ocean target --remove [--<set>...] [target...]\n";
}

// A TargetSet names a group of targets selected with --<name> or an alias.
// Empty system and arch match every target; native excludes WebAssembly.
struct TargetSet {
    name string;
    aliases string;
    system string;
    arch string;
    native bool;
}

func targetSets() []TargetSet {
    return []TargetSet{
        TargetSet{name: "all"},
        TargetSet{name: "native", native: true},
        TargetSet{name: "x86_64", aliases: "x86", arch: "x86_64"},
        TargetSet{name: "aarch64", aliases: "arm arm64", arch: "aarch64"},
        TargetSet{name: "riscv64", aliases: "riscv", arch: "riscv64"},
        TargetSet{name: "linux", system: "linux"},
        TargetSet{name: "macos", aliases: "darwin", system: "macos"},
        TargetSet{name: "windows", system: "windows"},
    };
}

func (s TargetSet) Contains(target util.Target) bool {
    if (s.native && target.Wasm()) return false;
    if (s.system != "" && target.system != s.system) return false;
    return s.arch == "" || target.arch == s.arch;
}

func (s TargetSet) Matches(flag string) bool {
    if (flag == s.name) return true;
    for (_, alias := range strings.Fields(s.aliases)) {
        if (flag == alias) return true;
    }
    return false;
}

func listTargetSets() int {
    util.Stdout("SET        ALIASES          TARGETS\n");
    for (_, set := range targetSets()) {
        names := make([]string);
        for (_, target := range util.KnownTargets()) {
            if (set.Contains(target)) names.append(target.Name());
        }
        aliases := "";
        for (_, alias := range strings.Fields(set.aliases)) {
            if (aliases != "") aliases = aliases + " ";
            aliases = aliases + "--" + alias;
        }
        flag := "--" + set.name;
        util.Stdout(flag + strings.Repeat(" ", 11 - len(flag)) +
            aliases + strings.Repeat(" ", 17 - len(aliases)) + strings.Join(names, " ") + "\n");
    }
    return 0;
}

func targetMain(args []string) int {
    if (len(args) == 0 || (len(args) == 1 && (args[0] == "--help" || args[0] == "-h"))) {
        util.Stdout(targetUsage());
        return 0;
    }
    if (len(args) == 1 && args[0] == "--list") return listTargets();
    if (len(args) == 1 && args[0] == "--sets") return listTargetSets();

    // Validate the entire argument list before changing any installation.
    remove := false;
    force := false;
    targets := make([]util.Target);
    seen: map[string]bool;
    for (_, arg := range args) {
        if (arg == "--remove") { remove = true; continue; }
        if (arg == "--force") { force = true; continue; }
        selected := make([]util.Target);
        if (strings.HasPrefix(arg, "-")) {
            found := false;
            for (_, set := range targetSets()) {
                if (!strings.HasPrefix(arg, "--") || !set.Matches(arg[2:])) continue;
                for (_, target := range util.KnownTargets()) {
                    if (set.Contains(target)) selected.append(target);
                }
                found = true;
                break;
            }
            if (!found) {
                if (arg == "--list" || arg == "--sets") {
                    util.Stderr("ocean target: " + arg + " cannot be combined with other arguments\n");
                } else {
                    util.Stderr("ocean target: unknown flag or set " + arg + ". See ocean target --sets.\n");
                }
                util.Stderr(targetUsage());
                return 1;
            }
        } else {
            name := arg;
            if (name == "86_64-windows") name = "x86_64-windows";
            for (_, target := range util.KnownTargets()) {
                if (target.Name() == name) { selected.append(target); break; }
            }
            if (len(selected) == 0) {
                util.Stderr("ocean target: unknown target " + name + ". See ocean target --list.\n");
                return 1;
            }
        }
        for (_, target := range selected) {
            _, duplicate := seen[target.Name()];
            if (!duplicate) { targets.append(target); seen[target.Name()] = true; }
        }
    }
    if (remove && force) {
        util.Stderr("ocean target: --force cannot be combined with --remove\n");
        return 1;
    }
    if (len(targets) == 0) { util.Stderr(targetUsage()); return 1; }

    root := targetRoot();
    if (root == "") {
        util.Stderr("ocean target: set OCEAN_TARGET_DIR to an absolute, writable directory\n");
        return 1;
    }
    // Every forced install uses the shared host tools, so refresh them once first.
    if (force && !ensureHostTools(root, true)) return 1;
    failed := false;
    for (_, target := range targets) {
        if (remove) {
            if (!removeTarget(root, target)) failed = true;
        } else if (!installTarget(root, target, force)) failed = true;
    }
    return failed ? 1 : 0;
}

func listTargets() int {
    dir, ok := util.MakeTempDir("ocean-target-list-");
    if (!ok) {
        util.Stderr("ocean target: could not create a temporary directory to check targets\n");
        return 1;
    }
    defer util.RemoveAll(dir);
    _, noColor := util.Getenv("NO_COLOR");
    force, _ := util.Getenv("CLICOLOR_FORCE");
    color := !noColor && (util.IsTerminal(1) || (force != "" && force != "0"));
    util.Stdout("TARGET           OCOS     OCARCH    READY\n");
    for (_, target := range util.KnownTargets()) {
        name := target.Name();
        ready := targetReady(target, dir);
        mark := ready ? "✓" : "✗";
        if (color) mark = (ready ? "\x1b[32m" : "\x1b[31m") + mark + "\x1b[0m";
        util.Stdout(name + strings.Repeat(" ", 17 - len(name)) +
            target.system + strings.Repeat(" ", 9 - len(target.system)) +
            target.arch + strings.Repeat(" ", 10 - len(target.arch)) + mark + "\n");
    }
    return 0;
}

func targetReady(target util.Target, dir string) bool {
    args := clangTargetArgs(target);
    if (!target.Wasm()) args.append(ffiCompileFlags(target)...);
    if (!appendTargetProbe(target, dir, &args)) return false;
    if (!target.Wasm() && !appendDependencyLinkFlags(target, &args, true, true, false)) return false;
    status, _ := util.RunCapture(args.array());
    if (status.Failed || status.Code != 0) return false;
    if (archivesLibraries(target)) {
        status, _ = util.RunCapture([]string{targetTool(managedTargetRoot(target), "llvm-ar"), "--version"}.array());
    }
    return !status.Failed && status.Code == 0;
}

func targetRoot() string {
    root, _ := util.Getenv("OCEAN_TARGET_DIR");
    if (root != "") return util.IsAbs(root) ? util.NormalizePath(root) : "";
    if (util.Windows()) root, _ = util.Getenv("LOCALAPPDATA");
    else root, _ = util.Getenv("HOME");
    if (root == "") return "";
    return util.NormalizePath(root + (util.Windows() ? "/Ocean" : "/.ocean") + "/targets");
}

// Untagged builds can still use toolchains installed by the previous compiler.
func bundleRelease() string { return bundleVersion == "" ? "nightly-2026.11.22" : bundleVersion; }

func versionedTargetRoot(root string) string { return root + "/" + bundleRelease(); }

func targetPath(root string, target util.Target) string {
    return versionedTargetRoot(root) + "/" + target.Name();
}

func hostToolPath(root string) string {
    return versionedTargetRoot(root) + "/host-" + util.HostTarget().Name();
}

func targetInstalled(path string) bool { return util.IsRegular(path + "/installed"); }

func removeTarget(root string, target util.Target) bool {
    path := targetPath(root, target);
    if (!targetInstalled(path)) {
        util.Stdout(target.Name() + " is not installed\n");
        return true;
    }
    // Detach the complete installation before deleting its contents.
    stage := targetStage(versionedTargetRoot(root));
    if (stage == "" || !util.Rename(path, stage + "/removed")) {
        if (stage != "") util.RemoveAll(stage);
        util.Stderr("ocean target: could not remove " + target.Name() + "\n");
        return false;
    }
    if (!util.RemoveAll(stage)) {
        util.Stderr("ocean target: could not clean up " + stage + "\n");
        return false;
    }
    util.Stdout("Removed " + target.Name() + "\n");
    return true;
}

func targetStage(parent string) string {
    if (!util.MkdirAll(parent)) return "";
    for (i := 0; i < 32; i++) {
        stage := parent + "/.target-" + strconv.Itoa(util.Pid()) + "-" + strconv.Itoa(i);
        if (util.Mkdir(stage)) return stage;
    }
    return "";
}

func targetCommand(args []string) bool {
    status, output := util.RunCapture(args.array());
    if (!status.Failed && status.Code == 0) return true;
    if (output != "") util.Stderr(output);
    util.Stderr("ocean target: " + args[0] + " failed\n");
    return false;
}

func verifyTargetArchive(archive string, digest string) bool {
    args := []string{"sha256sum", archive};
    if (util.MacOS()) args = []string{"shasum", "-a", "256", archive};
    if (util.Windows()) args = []string{"certutil.exe", "-hashfile", archive, "SHA256"};
    status, output := util.RunCapture(args.array());
    if (!status.Failed && status.Code == 0) {
        for (_, line := range strings.Split(output, "\n")) {
            line = strings.TrimSpace(line);
            if (line == digest || strings.HasPrefix(line, digest + " ")) return true;
        }
    }
    util.Stderr("ocean target: could not verify the SHA-256 of " + archive + "\n");
    return false;
}

func downloadTargetAsset(asset string, path string, showProgress bool) bool {
    return downloadTargetURL("https://github.com/ocean-foundation/ocean/releases/download/" + bundleVersion + "/" + asset,
        asset, path, showProgress);
}

func downloadTargetURL(url string, asset string, path string, showProgress bool) bool {
    progress := showProgress && util.IsTerminal(2) ? "--progress-bar" : "--silent";
    status := util.Run([]string{"curl", "--fail", "--location", progress, "--show-error", "--retry", "2",
        "--connect-timeout", "15", "--proto", "=https", "--proto-redir", "=https", "--output", path, url}.array());
    if (status.Failed || status.Code != 0) {
        util.Stderr("ocean target: could not download " + asset + "\n");
        return false;
    }
    return true;
}

func targetArchiveDigest(checksums string, asset string) string {
    for (_, line := range strings.Split(checksums, "\n")) {
        fields := strings.Fields(line);
        if (len(fields) != 2 || fields[1] != asset || len(fields[0]) != 64) continue;
        digest := strings.ToLower(fields[0]);
        valid := true;
        for (i := 0; i < len(digest); i++) {
            if (strings.IndexByte("0123456789abcdef", digest[i]) < 0) { valid = false; break; }
        }
        if (valid) return digest;
    }
    return "";
}

func unpackTargetBundle(stage string, destination string, target util.Target) bool {
    if (bundleVersion == "") {
        util.Stderr("ocean target: use a published Ocean release or rebuild with BUNDLE_VERSION set to a published tag\n");
        return false;
    }
    asset := "ocean-deps_" + bundleVersion + "_" + target.Name() + ".tar.xz";
    manifest := "SHA256SUMS_" + target.Name() + ".txt";
    if (!downloadTargetAsset(manifest, stage + "/" + manifest, false)) return false;
    checksums, _ := util.ReadFile(stage + "/" + manifest);
    digest := targetArchiveDigest(checksums, asset);
    if (digest == "") { util.Stderr("ocean target: missing SHA-256 for " + asset + "\n"); return false; }
    archive := stage + "/" + asset;
    util.Stdout("Downloading " + asset + "\n");
    if (!downloadTargetAsset(asset, archive, true)) return false;
    util.Stdout("Verifying download... ");
    if (!verifyTargetArchive(archive, digest) || !util.Mkdir(destination)) return false;
    util.Stdout("Extracting package... ");
    if (!targetCommand([]string{"tar", "-xf", archive, "-C", destination})) return false;
    return util.Remove(archive);
}

func ensureHostTools(root string, force bool) bool {
    path := hostToolPath(root);
    if (!force && targetInstalled(path)) return true;
    stage := targetStage(versionedTargetRoot(root));
    if (stage == "") { util.Stderr("ocean target: cannot stage host tools\n"); return false; }
    defer util.RemoveAll(stage);
    payload := stage + "/payload";
    if (!unpackTargetBundle(stage, payload, util.HostTarget())) return false;
    suffix := os.ExeSuffix();
    clang := payload + "/bin/clang" + suffix;
    linker := payload + "/bin/ld.lld" + suffix;
    if (!targetCommand([]string{clang, "--version"}) || !targetCommand([]string{linker, "--version"})) return false;
    if (!ensureLinkerDriver(payload, "wasm-ld") || !ensureLinkerDriver(payload, "ld64.lld")) return false;
    return publishTarget(payload, path, force);
}

// LLD selects its linker driver from the executable basename, so a copy of
// ld.lld named wasm-ld or ld64.lld links WebAssembly or Mach-O.
func ensureLinkerDriver(tools string, name string) bool {
    suffix := os.ExeSuffix();
    driver := tools + "/bin/" + name + suffix;
    if (util.IsExecutable(driver)) return true;
    binary, ok := util.ReadFile(tools + "/bin/ld.lld" + suffix);
    if (ok && util.WriteFileMode(driver, binary, 493)) return true;
    util.Stderr("ocean target: could not install " + name + "\n");
    return false;
}

// The default macOS SDK for other hosts is an osxcross-style SDK package,
// a MacOSX<version>.sdk directory packed as tar.xz from Xcode.
func macOSSDKVersion() string { return "15.5"; }
func macOSSDKDigest() string { return "c15cf0f3f17d714d1aa5a642da8e118db53d79429eb015771ba816aa7c6c1cbd"; }

func macOSSDKURL() string {
    return "https://github.com/joseluisq/macosx-sdks/releases/download/" + macOSSDKVersion() +
        "/MacOSX" + macOSSDKVersion() + ".sdk.tar.xz";
}

// installMacOSSDK places a macOS SDK at payload/MacOSX.sdk. OCEAN_MACOS_SDK may
// name an SDK directory or an SDK tarball such as one made by osxcross's
// gen_sdk_package.sh; otherwise the pinned SDK package is downloaded.
func installMacOSSDK(stage string, payload string) bool {
    source, _ := util.Getenv("OCEAN_MACOS_SDK");
    if (source != "" && util.IsDir(source)) {
        if (!util.IsAbs(source)) { util.Stderr("ocean target: OCEAN_MACOS_SDK must be an absolute path\n"); return false; }
        return util.WriteFile(payload + "/sdk", util.NormalizePath(source));
    }
    archive := source;
    if (archive == "") {
        asset := "MacOSX" + macOSSDKVersion() + ".sdk.tar.xz";
        archive = stage + "/" + asset;
        util.Stdout("Downloading " + asset + " (use of the macOS SDK is subject to the Xcode license agreement)\n");
        if (!downloadTargetURL(macOSSDKURL(), asset, archive, true)) return false;
        util.Stdout("Verifying download... ");
        if (!verifyTargetArchive(archive, macOSSDKDigest())) return false;
    } else if (!util.IsRegular(archive)) {
        util.Stderr("ocean target: OCEAN_MACOS_SDK is not an SDK directory or archive: " + archive + "\n");
        return false;
    }
    unpacked := stage + "/sdk";
    util.Stdout("Extracting SDK... ");
    if (!util.Mkdir(unpacked) || !targetCommand([]string{"tar", "-xf", archive, "-C", unpacked})) return false;
    if (source == "") util.Remove(archive);
    entries, _ := util.ListDir(unpacked);
    for (_, entry := range entries) {
        sdk := unpacked + "/" + entry;
        if (!strings.HasSuffix(entry, ".sdk") || !util.IsDir(sdk + "/usr/include")) continue;
        return util.Rename(sdk, payload + "/MacOSX.sdk") && util.WriteFile(payload + "/sdk", "MacOSX.sdk");
    }
    util.Stderr("ocean target: the SDK archive does not contain a MacOSX*.sdk directory\n");
    return false;
}

// crossMacOSTarget reports a macOS target linked by the bundled ld64.lld.
func crossMacOSTarget(target util.Target) bool {
    if (target.system != "macos") return false;
    root := managedTargetRoot(target);
    return root != "" && util.IsRegular(targetPath(root, target) + "/cross");
}

// A relative sdk entry names an SDK inside the target installation.
func macOSSDKPath(path string, sdk string) string {
    sdk = strings.TrimSpace(sdk);
    if (sdk == "" || util.IsAbs(sdk)) return sdk;
    return path + "/" + sdk;
}

// publishTarget moves a probed payload into place. With replace, an existing
// installation is first moved beside the payload, inside the stage directory
// that the caller deletes, and is restored if the new payload cannot be moved.
func publishTarget(payload string, path string, replace bool) bool {
    if (util.WriteFile(payload + "/installed", bundleRelease() + "\n")) {
        previous := payload + "-previous";
        detached := replace && util.Exists(path) && util.Rename(path, previous);
        if (util.Rename(payload, path)) return true;
        if (detached) util.Rename(previous, path);
        else if (!replace && targetInstalled(path)) return true;
    }
    util.Stderr("ocean target: could not install into " + path + "\n");
    return false;
}

// installTarget installs target unless it is already installed. With force, it
// reinstalls an existing installation and ignores the Apple SDK, so a macOS
// target always gets the bundled cross toolchain and SDK.
func installTarget(root string, target util.Target, force bool) bool {
    path := targetPath(root, target);
    if (!force && targetInstalled(path)) {
        // Host tools installed by earlier releases may lack a linker driver.
        if (util.IsRegular(path + "/cross") && !ensureLinkerDriver(hostToolPath(root), "ld64.lld")) return false;
        if (target.Wasm() && !ensureLinkerDriver(hostToolPath(root), "wasm-ld")) return false;
        util.Stdout(target.Name() + " is already installed\n");
        return true;
    }
    // On a Mac with the Command Line Tools, the Apple toolchain links macOS
    // targets. Other hosts use the bundled Clang and ld64.lld with a macOS SDK.
    sdk := "";
    xcode := false;
    if (target.system == "macos" && util.MacOS() && !force) {
        override, _ := util.Getenv("OCEAN_MACOS_SDK");
        status, output := util.RunCapture([]string{"xcrun", "--show-sdk-path"}.array());
        sdk = strings.TrimSpace(output);
        xcode = override == "" && !status.Failed && status.Code == 0 && util.IsDir(sdk) && util.IsExecutable("/usr/bin/clang");
        if (!xcode) sdk = "";
    }
    if (!xcode && !ensureHostTools(root, false)) return false;
    if (target.system == "macos" && !xcode && !ensureLinkerDriver(hostToolPath(root), "ld64.lld")) return false;
    if (target.Wasm() && !ensureLinkerDriver(hostToolPath(root), "wasm-ld")) return false;
    stage := targetStage(versionedTargetRoot(root));
    if (stage == "") { util.Stderr("ocean target: cannot stage " + target.Name() + "\n"); return false; }
    defer util.RemoveAll(stage);
    payload := stage + "/payload";
    if (target.system == "macos" || target.Wasm()) {
        if (!util.Mkdir(payload)) return false;
        if (xcode && !util.WriteFile(payload + "/sdk", sdk)) return false;
        if (target.system == "macos" && !xcode) {
            if (!installMacOSSDK(stage, payload) || !util.WriteFile(payload + "/cross", "")) return false;
            sdk, _ = util.ReadFile(payload + "/sdk");
            sdk = macOSSDKPath(payload, sdk);
        }
    } else if (!unpackTargetBundle(stage, payload, target)) return false;
    if (!probeTarget(root, target, stage, payload, sdk) || !publishTarget(payload, path, force)) return false;
    util.Stdout("Installed " + target.Name() + "\n");
    return true;
}

// Probe the SDK and bundled libraries before making a target visible to builds.
func probeTarget(root string, target util.Target, stage string, payload string, sdk string) bool {
    args := managedClangArgs(root, target, payload, sdk);
    if (!appendTargetProbe(target, stage, &args)) return false;
    if (!target.Wasm()) args.append("-lffi", "-lcurl");
    return targetCommand(args);
}

func appendTargetProbe(target util.Target, stage string, args *[]string) bool {
    source := stage + "/probe.c";
    program := "#include <stdlib.h>\n#include <ffi.h>\n#include <curl/curl.h>\nint main(void) { return curl_version() == NULL || ffi_type_void.size != 1; }\n";
    if (target.Wasm()) program = "int main(void) { return 0; }\n";
    if (!util.WriteFile(source, program)) return false;
    (*args).append(source, "-o", stage + "/" + target.Name() + target.ExeSuffix());
    if (target.Wasm()) (*args).append("-nostdlib", "-Wl,--no-entry", "-Wl,--export=main");
    return true;
}

func managedTargetRoot(target util.Target) string {
    if (!target.explicit || !target.Supported()) return "";
    clang, _ := util.Getenv("OCEAN_CLANG");
    sysroot, _ := util.Getenv("OCEAN_SYSROOT");
    if (clang != "" || sysroot != "") return "";
    root := targetRoot();
    if (root == "") return "";
    if (targetInstalled(targetPath(root, target))) return root;
    // WebAssembly only needs the shared host tools and the bundled runtime.
    // Both must be present; otherwise the system Clang and wasm-ld are used.
    if (target.Wasm() && targetTool(root, "clang") != "clang" && targetTool(root, "wasm-ld") != "wasm-ld") return root;
    return "";
}

func targetTool(root string, name string) string {
    if (root != "") {
        path := hostToolPath(root) + "/bin/" + name + os.ExeSuffix();
        if (util.IsExecutable(path)) return path;
    }
    return name;
}

func managedClangArgs(root string, target util.Target, payload string, sdk string) []string {
    bin := hostToolPath(root) + "/bin/";
    if (target.system == "macos" && !util.IsRegular(payload + "/cross")) {
        return []string{"/usr/bin/clang", "--target=" + target.Triple(), "-isysroot", sdk, "-iwithsysroot", "/usr/include/ffi"};
    }
    if (target.system == "macos") {
        clang := targetTool(root, "clang");
        args := []string{clang, "--target=" + target.Triple()};
        if (clang != "clang") args.append("--no-default-config");
        args.append("-isysroot", sdk, "-iwithsysroot", "/usr/include/ffi",
            "-fuse-ld=lld", "--ld-path=" + targetTool(root, "ld64.lld"));
        return args;
    }
    clang := targetTool(root, "clang");
    args := []string{clang, "--target=" + target.Triple()};
    if (clang != "clang") args.append("--no-default-config");
    if (target.Wasm()) {
        // Debian-built Clang looks for a versioned wasm-ld-<major> by default,
        // so name the bundled linker by its absolute path.
        args.append("-B" + bin);
        linker := targetTool(root, "wasm-ld");
        if (linker != "wasm-ld") args.append("-fuse-ld=" + linker);
    } else {
        args.append("-I" + payload + "/include", "-L" + payload + "/lib",
            "-fuse-ld=lld", "--ld-path=" + targetTool(root, "ld.lld"));
        if (target.system == "linux") {
            sysroot := payload + "/sysroot";
            args.append("--sysroot=" + sysroot, "--gcc-toolchain=" + sysroot + "/usr",
                "-Wl,-rpath-link," + payload + "/lib");
        } else {
            args.append("--sysroot=" + payload, "--rtlib=compiler-rt");
            versions, _ := util.ListDir(payload + "/lib/clang");
            for (_, version := range versions) {
                resource := payload + "/lib/clang/" + version;
                if (util.IsDir(resource + "/include")) { args.append("-resource-dir=" + resource); break; }
            }
        }
    }
    return args;
}
