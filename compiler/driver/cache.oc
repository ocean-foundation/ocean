package driver;
import "github.com/ocean-foundation/ocean/compiler/runtime";
import "github.com/ocean-foundation/ocean/compiler/util";
import "os";
import "strconv";

// Build cache: finished artifacts keyed by a hash of everything that affects
// them (IR, runtime sources, link mode, optimization level, compiler version).

func cacheRoot() string {
    o, ok := util.Getenv("OCEAN_BUILD_CACHE");
    if (ok && o == "off") return "";
    if (ok && o != "") return o + "/oc1";
    home, hok := util.Getenv("HOME");
    if ((!hok || home == "") && util.Windows()) { home, hok = util.Getenv("LOCALAPPDATA"); }
    if (!hok || home == "") return "";
    return home + "/.cache/ocean-build/oc1";
}

func hashField(h *util.Sha256, label string, val string) {
    h.WriteString(label);
    h.WriteString(":");
    h.WriteString(strconv.Itoa(len(val)));
    h.WriteString(":");
    h.WriteString(val);
    h.WriteString("\n");
}

cachedClangVersion := "";
clangVersionChecked := false;

func clangVersion() string {
    if (clangVersionChecked) return cachedClangVersion;
    clangVersionChecked = true;
    st, out := util.RunCapture([]string{"clang", "--version"}.array());
    if (!st.Failed && st.Code == 0) cachedClangVersion = out;
    return cachedClangVersion;
}

func cacheKey(p *Program, ir string, staticLink bool) string {
    h := util.NewSha256();
    hashField(&h, "ir", ir);
    hashField(&h, "core", runtime.Core());
    if (targetWasm()) {
        hashField(&h, "wasm", runtime.Wasm());
    } else {
        if (p.checker.UsesThreads()) hashField(&h, "threads", runtime.Threads());
        if (usesPackage(p, "os/exec")) hashField(&h, "process", runtime.Process());
        if (p.usesFFI) hashField(&h, "ffi", runtime.Ffi());
    }
    hashField(&h, "curl", p.usesCurl ? "1" : "0");
    hashField(&h, "mode", p.isLibrary ? "lib" : "exe");
    hashField(&h, "static", staticLink ? "1" : "0");
    hashField(&h, "opt", optLevel());
    hashField(&h, "ver", Version());
    hashField(&h, "commit", Commit());
    hashField(&h, "os", os.OS());
    hashField(&h, "arch", os.Arch());
    ocos, _ := util.Getenv("OCOS");
    ocarch, _ := util.Getenv("OCARCH");
    cross, _ := util.Getenv("OCEAN_CROSS_TARGET");
    hashField(&h, "ocos", ocos);
    hashField(&h, "ocarch", ocarch);
    hashField(&h, "cross", cross);
    hashField(&h, "clang", clangVersion());
    return h.SumHex();
}

func cacheLookup(key string, output string) bool {
    root := cacheRoot();
    if (root == "") return false;
    entry := root + "/" + key[0:2] + "/" + key;
    if (!util.IsRegular(entry)) return false;
    data, ok := util.ReadFile(entry);
    if (!ok) return false;
    return util.WriteFileAtomic(output, data, 493);
}

func cacheStore(key string, output string) {
    root := cacheRoot();
    if (root == "") return;
    dir := root + "/" + key[0:2];
    if (!util.MkdirAll(dir)) return;
    data, ok := util.ReadFile(output);
    if (!ok) return;
    util.WriteFileAtomic(dir + "/" + key, data, 420);
}

func cleanCache() int {
    root := cacheRoot();
    if (root == "" || !util.Exists(root)) return 0;
    if (!util.RemoveAll(root)) { util.Stderr("ocean: could not clean build cache\n"); return 1; }
    return 0;
}
