package driver;
import "github.com/ocean-foundation/ocean/compiler/loader";
import "github.com/ocean-foundation/ocean/compiler/util";
import "os/signal";
import "strconv";
import "strings";

struct PackageRun {
    pid int;
    out int; errs int; grant int;
    exited bool; status int; finished bool;
    held int; pending int;
    finalFailed bool;
    buffer string;
    started float; elapsed float;
    r *Reporter;
}

func packageLine(p *PackageRun, line string) {
    action := jsonField(line, "Action");
    if (action == "acquire") { p.pending++; return; }
    if (action == "release") { if (p.held > 0) p.held--; return; }
    if (action != "") {
        if (action == "output" && jsonField(line, "Test") == "") p.r.packageOutput += jsonField(line, "Output");
        testEvent(p.r, line);
        if ((action == "pass" || action == "fail") && jsonField(line, "Test") == "") {
            p.finalFailed = action == "fail";
            p.elapsed = jsonElapsed(line);
        }
        return;
    }
    emitJSON(p.r, "output", "", line, 0.0);
    p.r.packageOutput += line;
}

func packageSummary(out *Reporter, runs []*PackageRun, elapsed float) {
    if (len(runs) == 0) return;
    totals := []int{0, 0, 0, 0};
    nameWidth := 5; statusWidth := 2;
    totalTime := durationText(elapsed);
    timeWidth := util.Width(totalTime);
    for (_, p := range runs) {
        r := p.r;
        if (len(r.pkg) > nameWidth) nameWidth = len(r.pkg);
        if (p.status != 0) statusWidth = 4;
        vals := []int{r.passed, r.failed, r.skipped, r.passed + r.failed + r.skipped};
        for (j := 0; j < 4; j++) totals[j] += vals[j];
        d := durationText(p.elapsed > 0.0 ? p.elapsed : elapsed);
        if (util.Width(d) > timeWidth) timeWidth = util.Width(d);
    }
    widths := []int{digits(totals[0]), digits(totals[1]), digits(totals[2]), digits(totals[3])};
    label := "(" + strconv.Itoa(len(runs)) + " packages)";
    minLabel := len(label);
    if (minLabel < 13) minLabel = 13;
    if (nameWidth + statusWidth + 4 < minLabel) nameWidth = minLabel - statusWidth - 4;
    countsWidth := widths[0] + widths[1] + widths[2] + widths[3] + 9;
    maxName := 150 - statusWidth - 4 - countsWidth - timeWidth - 4;
    if (maxName < 1) maxName = 1;
    if (nameWidth > maxName) nameWidth = maxName;
    labelWidth := statusWidth + 4 + nameWidth;
    lineWidth := labelWidth + countsWidth + timeWidth + 4;
    for (_, p := range runs) details(p.r, lineWidth, p.status);
    icons := []string{"✓", "✗", "∅", "∑"};
    for (row := 0; row <= len(runs); row++) {
        if (row == 0 || row == len(runs)) {
            if (row == 0) { tprint(out, "─── Summary "); rule(out, labelWidth + widths[0] - 12); }
            else rule(out, labelWidth + widths[0]);
            for (j := 0; j < 4; j++) {
                tprint(out, " " + icons[j] + " ");
                rule(out, j == 3 ? (timeWidth > 1 ? timeWidth - 1 : 1) : widths[j + 1]);
            }
            tprint(out, " ⏱\n");
        }
        vals := make([]int);
        dur := "";
        if (row < len(runs)) {
            p := runs[row]; r := p.r;
            color := "";
            if (out.color) color = p.status != 0 ? "\x1b[31m" : "\x1b[32m";
            tprint(out, color + util.PadRight(p.status != 0 ? "FAIL" : "ok", statusWidth) + (out.color ? "\x1b[0m" : "") + "    " + util.PadRight(clip(r.pkg, nameWidth), nameWidth) + "  ");
            vals.append(r.passed, r.failed, r.skipped, r.passed + r.failed + r.skipped);
            dur = durationText(p.elapsed > 0.0 ? p.elapsed : elapsed);
        } else {
            tprint(out, util.PadRight(label, labelWidth) + "  ");
            vals.append(totals...);
            dur = totalTime;
        }
        for (j := 0; j < 4; j++) {
            if (j > 0) tprint(out, "   ");
            if (row < len(runs) && vals[j] == 0) tprint(out, strings.Repeat(" ", widths[j]));
            else tprint(out, util.PadLeft(strconv.Itoa(vals[j]), widths[j]));
        }
        tprint(out, "  " + util.PadLeft(dur, timeWidth) + "\n");
    }
}

func testPackages(flags []string, list []string, reportPath string, jsonPath string, json bool, notty bool) int {
    workers := 16;
    _, noColorEnv := util.Getenv("NO_COLOR");
    color := !noColorEnv;
    includePassed := false; includeSkipped := true;
    for (i := 0; i < len(flags); i++) {
        f := flags[i];
        if (f == "--single-threaded") workers = 1;
        else if (f == "-t") {
            i++;
            if (i >= len(flags)) { util.Stderr("ocean test: -t requires a thread count\n"); return 1; }
            parsed := strconv.Atoi(flags[i]);
            n := parsed.unwrapOrZero();
            if (parsed.hasError() || n < 1) { util.Stderr("ocean test: invalid thread count\n"); return 1; }
            workers = n;
        } else if (f == "--no-color") color = false;
        else if (f == "-v" || f == "--include-passed") includePassed = true;
        else if (f == "--hide-skipped") includeSkipped = false;
    }
    if (reportPath != "" && jsonPath != "" && (reportPath == jsonPath || sameFile(reportPath, jsonPath))) {
        util.Stderr("ocean test: report and JSON paths must differ\n"); return 1;
    }
    reportBuf := zero(*util.Buf); jsonBuf := zero(*util.Buf);
    if (reportPath != "") reportBuf = util.NewBuf();
    jsonFD := -1;
    if (jsonPath != "") {
        jsonBuf = util.NewBuf();
        jsonFD = util.OpenTrunc(jsonPath);
        if (jsonFD < 0) { util.Stderr("ocean test: result file: could not open " + jsonPath + "\n"); return 1; }
    }
    childArgs := []string{loader.Executable(), "test", "--internal-test-package"};
    for (i := 0; i < len(flags); i++) {
        f := flags[i];
        if (f == "--outfile" || f == "-outfile" || f == "-o" || f == "--jsonfile" || f == "-jsonfile") { i++; continue; }
        childArgs.append(f);
    }
    childArgs.append("--json", "--notty");
    // live shared display: every package's events go to one "packages" frontend
    ui := newReporter();
    ui.pkg = "packages"; ui.color = color; ui.includeSkipped = includeSkipped;
    tmpDir := "";
    if (isTerminalOk(false, json) && !notty) {
        d, tok := util.MakeTempDir(".ocean-packages-");
        if (tok) {
            tmpDir = d;
            exe := buildDisplay(tmpDir);
            if (exe != "") startDisplay(ui, exe);
            else util.Stderr("ocean test: live display unavailable; using final report\n");
        }
    }
    signal.Block();
    interrupted := 0;
    cancelled := 0.0;
    runs := make([]*PackageRun);
    for (_, loc := range list) {
        p := new(PackageRun);
        p.out = -1; p.errs = -1; p.grant = -1;
        r := newReporter();
        r.pkg = loader.NewBuild(newDiags()).PackageTestPath(loc);
        r.json = json; r.jsonFile = jsonBuf; r.reportBuf = reportBuf; r.jsonFD = jsonFD;
        r.includePassed = includePassed; r.includeSkipped = includeSkipped;
        r.color = color && util.IsTerminal(1);
        if (ui.displayFD >= 0) { r.displayFD = ui.displayFD; r.display = ui.display; r.multiPackage = hexEncode(r.pkg); }
        p.r = r;
        runs.append(p);
    }
    next := 0; finished := 0; active := 0; fair := 0;
    status := 0;
    start := util.MonoSeconds();
    for (finished < len(runs)) {
        if (checkDisplay(ui) && interrupted == 0) interrupted = 2;
        if (ui.displayFD < 0) { for (_, p := range runs) p.r.displayFD = -1; }
        sig := signal.Pending();
        if (sig != 0 && interrupted == 0) interrupted = sig;
        if (interrupted != 0 && cancelled == 0.0) {
            cancelled = util.MonoSeconds(); status = 128 + interrupted;
            for (i := 0; i < next; i++) { if (!runs[i].finished) util.KillGroup(runs[i].pid, interrupted); }
        }
        if (cancelled > 0.0 && next == finished) break;
        if (cancelled > 0.0 && util.MonoSeconds() - cancelled > 1.0) {
            for (i := 0; i < next; i++) { if (!runs[i].finished) util.KillGroup(runs[i].pid, 9); }
        }
        flushDisplay(ui);
        for (cancelled == 0.0 && next < len(runs) && active < workers) {
            p := runs[next];
            o1, o2, ok1 := util.Pipe();
            e1, e2, ok2 := util.Pipe();
            g1, g2, ok3 := util.Pipe();
            if (!ok1 || !ok2 || !ok3) { util.Stderr("ocean test: pipe\n"); return 1; }
            args := make([]string);
            args.append(childArgs...);
            args.append(list[next]);
            maps := []int{o2, 1, e2, 2, g1, 199};
            pid := util.SpawnMapped(args.array(), maps, true, true);
            util.CloseFd(o2); util.CloseFd(e2); util.CloseFd(g1);
            if (pid < 0) { util.CloseFd(o1); util.CloseFd(e1); util.CloseFd(g2); return 1; }
            p.started = util.MonoSeconds(); p.pid = pid; p.out = o1; p.errs = e1; p.grant = g2;
            // show the package while it is still compiling
            if (p.r.displayFD >= 0 && !p.r.displayStarted) { displaySend(p.r, "start", "", "", 0.0); p.r.displayStarted = true; }
            util.SetNonblock(g2);
            next++; active++;
        }
        polled := make([]int); evs := make([]int);
        for (i := 0; i < next; i++) { polled.append(runs[i].out, runs[i].errs); evs.append(1, 1); }
        rev := util.Poll(polled, evs, 10);
        for (i := 0; i < next; i++) {
            p := runs[i];
            if (p.finished) continue;
            for (which := 0; which < 2; which++) {
                fd := which == 0 ? p.out : p.errs;
                if (fd < 0 || (rev[i * 2 + which] & (1 | 8 | 16)) == 0) continue;
                chunk := util.ReadFd(fd, 8192);
                if (chunk == "") { util.CloseFd(fd); if (which == 1) p.errs = -1; else p.out = -1; continue; }
                if (which == 1) { p.r.packageOutput += chunk; emitJSON(p.r, "output", "", chunk, 0.0); }
                else {
                    p.buffer += chunk;
                    for (_, line := range takeLines(&p.buffer)) packageLine(p, line);
                }
            }
            if (!p.exited) {
                done, st := util.WaitNoHang(p.pid);
                if (done) { p.exited = true; p.status = st.Code; util.KillGroup(p.pid, 9); }
            }
            if (p.exited && p.out < 0 && p.errs < 0) {
                if (p.buffer != "") packageLine(p, p.buffer);
                p.held = 0; p.pending = 0;
                util.CloseFd(p.grant); p.grant = -1;
                p.finished = true; active--; finished++;
                if ((!p.r.completed || p.r.failed > 0) && p.status == 0) p.status = 1;
                if (p.status != 0) status = p.status;
                if (!p.r.completed || (p.status != 0 && !p.finalFailed)) emitJSON(p.r, "fail", "", "package process failed", util.MonoSeconds() - start);
            }
        }
        held := 0;
        for (i := 0; i < next; i++) held += runs[i].held;
        for (held < workers && next > 0) {
            granted := false;
            for (attempt := 0; attempt < next && held < workers; attempt++) {
                p := runs[fair % next];
                fair++;
                if (!p.finished && p.pending > 0 && util.WriteSome(p.grant, "+") == 1) { p.pending--; p.held++; held++; granted = true; }
            }
            if (!granted) break;
        }
    }
    if (interrupted != 0) status = 128 + interrupted;
    stopDisplay(ui, util.MonoSeconds() - start, status);
    if (tmpDir != "") util.RemoveAll(tmpDir);
    signal.Unblock();
    done := make([]*PackageRun);
    for (i := 0; i < next; i++) done.append(runs[i]);
    packageSummary(runs[0].r, done, util.MonoSeconds() - start);
    if (!ast_nilBuf(reportBuf) && !util.WriteBufFile(reportPath, reportBuf)) status = 1;
    if (jsonFD >= 0) {
        bad := !util.Close(jsonFD);
        for (_, p := range runs) { if (p.r.jsonFailed) bad = true; }
        if (bad) status = 1;
    }
    return status;
}
