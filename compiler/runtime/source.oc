    pthread_attr_t attributes;
    int failed = pthread_attr_init(&attributes);
    if (!failed) {
        size_t stack_size = 0;
        failed = pthread_attr_getstacksize(&attributes, &stack_size);
        const size_t minimum_stack = 8 * 1024 * 1024;
        if (!failed && stack_size < minimum_stack)
