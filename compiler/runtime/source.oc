#else
    return posix_spawn_file_actions_addchdir_np(actions, directory);
#endif
}
/* Creates an unlinked, close-on-exec temporary file descriptor >= 3 so it
 * cannot leak to concurrently spawned children or collide with fds 0..2. */
static int temp_fd(void) {
    const char *dir = getenv("TMPDIR");
    if (!dir || !*dir) dir = "/tmp";
    size_t n = strlen(dir);
    while (n > 1 && dir[n - 1] == '/') n--;
    char *path = malloc(n + 16);
    if (!path) return -1;
    memcpy(path, dir, n);
    memcpy(path + n, "/ocean-XXXXXX", 14);
    int fd = mkostemp(path, O_CLOEXEC);
    if (fd >= 0) unlink(path);
    free(path);
    if (fd < 0) return -1;
    if (fd < 3) {
        int moved = fcntl(fd, F_DUPFD_CLOEXEC, 3);
        close(fd);
        if (moved < 0) return -1;
        fd = moved;
    }
    return fd;
}
/* A rewound temporary file holding input, for a child's standard input. */
static int input_file(const char *input, int64_t size) {
    int fd = temp_fd();
    if (fd < 0) return -1;
    for (int64_t done = 0; done < size; ) {
        ssize_t w = write(fd, input + done, (size_t)(size - done));
        if (w < 0) { if (errno == EINTR) continue; close(fd); return -1; }
        if (w == 0) { close(fd); return -1; }
        done += w;
    }
    if (lseek(fd, 0, SEEK_SET) < 0) { close(fd); return -1; }
    return fd;
}
/* Starts p with optional standard-input and capture fds (>= 3); returns the pid or -1. */
static pid_t spawn(OceanProcess *p, int input, int capture) {
    const char *exec_path = p->path;
    char *resolved = NULL;
    if (!exec_path || !*exec_path) { fail(p, "exec: executable could not be started"); return -1; }
    if (!strchr(exec_path, '/')) {
        resolved = ocean_process_lookpath(exec_path);
        if (!resolved) { fail(p, "exec: executable not found or resolves relative to current directory"); return -1; }
        exec_path = resolved;
    }
    posix_spawn_file_actions_t actions;
    if (posix_spawn_file_actions_init(&actions)) { free(resolved); fail(p, "exec: cannot initialize spawn actions"); return -1; }
    int failed = 0;
    if (input >= 0) failed = posix_spawn_file_actions_adddup2(&actions, input, 0);
    if (!failed && capture >= 0) {
        failed = posix_spawn_file_actions_adddup2(&actions, capture, 1);
        if (!failed && p->combined) failed = posix_spawn_file_actions_adddup2(&actions, capture, 2);
    }
    if (!failed && p->directory && *p->directory) failed = add_directory(&actions, p->directory);
#ifdef __APPLE__
    char **env = p->environment ? (char **)p->environment : *_NSGetEnviron();
#else
    char **env = p->environment ? (char **)p->environment : environ;
#endif
    pid_t child = -1;
    if (!failed) failed = posix_spawn(&child, exec_path, &actions, NULL, (char *const *)p->argv, env);
    free(resolved);
    posix_spawn_file_actions_destroy(&actions);
    if (failed) { fail(p, "exec: executable could not be started"); return -1; }
    return child;
}
int32_t ocean_process_run_input(OceanProcess *p, const char *input, int64_t input_size, int64_t has_input) {
    p->exit_code = -1; p->output = NULL; p->output_size = 0; p->error = NULL;
    size_t out_cap = 0;
    int file = p->capture ? temp_fd() : -1;
    if (p->capture && file < 0) return fail(p, "exec: executable could not be started");
    int stdin_file = has_input ? input_file(input, input_size) : -1;
    if (has_input && stdin_file < 0) { if (file >= 0) close(file); return fail(p, "exec: cannot create input file"); }
    pid_t child = spawn(p, stdin_file, file);
    if (stdin_file >= 0) close(stdin_file);
    if (child < 0) { if (file >= 0) close(file); return 1; }
    int status;
    while (waitpid(child, &status, 0) < 0) { if (errno != EINTR) { if (file >= 0) close(file); return fail(p, "exec: wait failed"); } if (interrupted) kill(child, SIGTERM); }
    p->exit_code = WIFEXITED(status) ? WEXITSTATUS(status) : -1;
    int read_ok = 1;
    if (file >= 0) {
        if (lseek(file, 0, SEEK_SET) < 0) read_ok = 0;
        char buffer[8192];
        while (read_ok) {
            ssize_t n = read(file, buffer, sizeof(buffer));
            if (n < 0) { if (errno == EINTR) continue; read_ok = 0; break; }
            if (n == 0) break;
            if (!append(p, &out_cap, buffer, (size_t)n)) read_ok = 0;
        }
        close(file);
    }
    if (!read_ok) return fail(p, "exec: output read failed");
    return p->exit_code ? fail(p, "exec: process exited unsuccessfully") : 0;
}
/* Starts p without capture; *handle receives the pid for wait/kill. */
int32_t ocean_process_start(OceanProcess *p, const char *input, int64_t input_size, int64_t has_input, int64_t *handle, int64_t *pid) {
    p->exit_code = -1; p->output = NULL; p->output_size = 0; p->error = NULL; *handle = 0; *pid = -1;
    int stdin_file = has_input ? input_file(input, input_size) : -1;
    if (has_input && stdin_file < 0) return fail(p, "exec: cannot create input file");
    p->capture = 0; p->combined = 0;
    pid_t child = spawn(p, stdin_file, -1);
    if (stdin_file >= 0) close(stdin_file);
    if (child < 0) return 1;
    *handle = child; *pid = child;
    return 0;
}
/* Returns 1 when the process has exited (reaping it), 0 while it runs (only
 * without block), or -1 on failure. A signal exit reports exit code -1. */
int32_t ocean_process_wait(int64_t handle, int64_t block, int64_t *exit_code, int64_t *signal_number) {
    *exit_code = -1; *signal_number = 0;
    if (handle <= 0) return -1;
    int status; pid_t result;
    while ((result = waitpid((pid_t)handle, &status, block ? 0 : WNOHANG)) < 0) if (errno != EINTR) return -1;
    if (result == 0) return 0;
    if (WIFEXITED(status)) *exit_code = WEXITSTATUS(status);
    else if (WIFSIGNALED(status)) *signal_number = WTERMSIG(status);
    return 1;
}
int32_t ocean_process_kill(int64_t handle) {
    if (handle <= 0) return -1;
    return kill((pid_t)handle, SIGKILL) ? -1 : 0;
}
int32_t ocean_process_run(OceanProcess *p) { return ocean_process_run_input(p, NULL, 0, 0); }
#endif
`;
}

func Ffi() string {
    return `/* C variadic calls whose argument count is known only at run time (array or
 * ...any expansion). Linked only into programs that need it; requires libffi. */
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <ffi.h>

typedef struct OcType OcType;
struct OcType { int64_t kind, size, align, bits, flags; const OcType *elem, *key; const char *name; };
typedef struct { const OcType *t; void *data; } OcAny;
typedef struct OcArr { int64_t len, cap; char *data; } OcArr;
enum { K_INT = 1, K_FLOAT, K_BOOL, K_STRING, K_PTR, K_DYN, K_ARRAY, K_BUFFER, K_MAP, K_STRUCT, K_ENUM, K_IFACE, K_FUNC, K_BUFLIST };
/* slot kinds: 1 i32, 2 i64, 3 double, 4 float, 5 pointer, 6 i8, 7 i16, 0 void */
static ffi_type *slot_type(int64_t k) {
    switch (k) {
    case 1: return &ffi_type_sint32;
    case 2: return &ffi_type_sint64;
    case 3: return &ffi_type_double;
    case 4: return &ffi_type_float;
    case 5: return &ffi_type_pointer;
    case 6: return &ffi_type_sint8;
    case 7: return &ffi_type_sint16;
    }
    return &ffi_type_void;
}
extern void *oc_str_cdata(OcArr *a);
static void *ffi_calloc(size_t count, size_t sz) {
    size_t tot;
    if (__builtin_mul_overflow(count, sz, &tot)) __builtin_trap();
    void *p = calloc(1, tot ? tot : 1);
    if (!p) __builtin_trap();
    return p;
}
static void store_slot(int64_t kind, uint64_t raw, uint64_t *dst) {
    *dst = 0;
    if (kind == 4) {
        uint32_t bits = (uint32_t)raw;
        float fv;
        memcpy(&fv, &bits, 4);
        memcpy(dst, &fv, sizeof(fv));
    } else if (kind == 1) {
        int32_t iv = (int32_t)raw;
        memcpy(dst, &iv, sizeof(iv));
    } else if (kind == 6) {
        int8_t iv = (int8_t)raw;
        memcpy(dst, &iv, sizeof(iv));
    } else if (kind == 7) {
        int16_t iv = (int16_t)raw;
        memcpy(dst, &iv, sizeof(iv));
    } else if (kind == 5) {
        void *p = (void *)(uintptr_t)raw;
        memcpy(dst, &p, sizeof(p));
    } else {
        *dst = raw;
    }
}
/* Classify a boxed value with C default argument promotions. */
static void promote(const OcAny *a, int64_t *kind, uint64_t *value) {
    const OcType *t = a->t;
    *kind = 2; *value = 0;
    if (!t) { *kind = 5; return; }
    if (t->kind == K_BUFFER && t->bits <= 0) {
        *kind = 5;
        store_slot(5, (uint64_t)(uintptr_t)a->data, value);
        return;
    }
    if (!a->data) { *kind = 5; return; }
    if (t->kind == K_INT || t->kind == K_BOOL) {
        int64_t bits = t->kind == K_BOOL ? 1 : t->bits;
        uint64_t raw = 0;
        size_t sz = (t->size > 0 && t->size < 8) ? (size_t)t->size : (t->size >= 8 ? 8 : 0);
        if (sz) memcpy(&raw, a->data, sz);
        if (bits < 64) raw &= ((uint64_t)1 << bits) - 1;
        int sign = (t->flags & 1) && bits < 64 && ((raw >> (bits - 1)) & 1);
        if (sign) raw |= ~(((uint64_t)1 << bits) - 1);
        *kind = bits <= 32 ? 1 : 2;
        store_slot(*kind, raw, value);
        return;
    }
    if (t->kind == K_FLOAT) {
        double d = t->bits == 32 ? *(const float *)a->data : *(const double *)a->data;
        memcpy(value, &d, 8); *kind = 3; return;
    }
    if (t->kind == K_STRING) {
        *kind = 5;
        store_slot(5, (uint64_t)(uintptr_t)oc_str_cdata(*(OcArr *const *)a->data), value);
        return;
    }
    *kind = 5;
    if (t->kind == K_PTR || t->kind == K_FUNC) {
        size_t sz = (t->size > 0 && t->size < 8) ? (size_t)t->size : (t->size >= 8 ? 8 : 0);
        if (sz) memcpy(value, a->data, sz);
    } else {
        store_slot(5, (uint64_t)(uintptr_t)a->data, value);
    }
}
/* fn: target; ret: slot kind of the result; n fixed+explicit slots in kinds/values,
 * nfixed of them declared; extras: dynamic array of OcAny appended. */
uint64_t oc_cvar_call(void *fn, int64_t ret, int64_t nfixed, int64_t n, const int64_t *kinds, const uint64_t *values, OcArr *extras) {
    if (n < 0 || nfixed < 0) __builtin_trap();
    int64_t nextra = extras ? extras->len : 0;
    if (nextra < 0) __builtin_trap();
    int64_t total;
    if (__builtin_add_overflow(n, nextra, &total) || total < 0 || (uint64_t)total > (SIZE_MAX / sizeof(uint64_t)) - 1) __builtin_trap();
    size_t cap = (size_t)total + 1;
    ffi_type **types = ffi_calloc(cap, sizeof(*types));
    void **args = ffi_calloc(cap, sizeof(*args));
    uint64_t *store = ffi_calloc(cap, sizeof(*store));
    int64_t *k = ffi_calloc(cap, sizeof(*k));
    for (int64_t i = 0; i < n; i++) { k[i] = kinds[i]; store_slot(k[i], values[i], &store[i]); }
    for (int64_t i = 0; i < nextra; i++) promote(&((OcAny *)extras->data)[i], &k[n + i], &store[n + i]);
    for (int64_t i = 0; i < total; i++) { types[i] = slot_type(k[i]); args[i] = &store[i]; }
    ffi_cif cif;
    if (ffi_prep_cif_var(&cif, FFI_DEFAULT_ABI, (unsigned)nfixed, (unsigned)total, slot_type(ret), types) != FFI_OK) abort();
    uint64_t out = 0;
    if (ret == 3) {
        double dres = 0.0;
        ffi_call(&cif, FFI_FN(fn), &dres, args);
        memcpy(&out, &dres, 8);
    } else if (ret == 4) {
        float fres = 0.0f;
        ffi_call(&cif, FFI_FN(fn), &fres, args);
        uint32_t bits = 0;
        memcpy(&bits, &fres, 4);
        out = (uint64_t)bits;
    } else if (ret == 5) {
        void *pres = NULL;
        ffi_call(&cif, FFI_FN(fn), &pres, args);
        out = (uint64_t)(uintptr_t)pres;
    } else {
        ffi_arg ares = 0;
        ffi_call(&cif, FFI_FN(fn), ret ? (void *)&ares : NULL, args);
        if (ret == 6) out = (uint64_t)(int64_t)(int8_t)ares;
        else if (ret == 7) out = (uint64_t)(int64_t)(int16_t)ares;
        else if (ret == 1) out = (uint64_t)(int64_t)(int32_t)ares;
        else out = (uint64_t)ares;
    }
    free(types); free(args); free(store); free(k);
    return out;
}
`;
}

func Wasm() string {
    return `/* Ocean runtime support for wasm32-unknown-unknown: the small, freestanding
 * subset of the C library that core.c uses. It is used both as the header of
 * the generated <stdlib.h>, <stdio.h>, ... shims (declarations only) and, with
 * OCEAN_WASM_IMPL defined, as their implementation.
 *
 * Linear memory grows on demand through memory.grow. The host may provide
 * env.ocean_write(fd, pointer, length) to receive panic reports; nothing is
 * imported unless such output is reachable. Without native unwinding there is
 * no setjmp/longjmp: recovering from a panic traps. */
#ifndef OCEAN_WASM_LIBC
#define OCEAN_WASM_LIBC
#include <stddef.h>
#include <stdint.h>
#include <stdarg.h>

typedef long ssize_t;
typedef struct OcWasmFile { int fd; } FILE;
extern FILE *stdout, *stderr;
#define EOF (-1)

void *malloc(size_t n);
void *calloc(size_t count, size_t size);
void *realloc(void *p, size_t n);
void free(void *p);
void *memcpy(void *dst, const void *src, size_t n);
void *memmove(void *dst, const void *src, size_t n);
void *memset(void *dst, int c, size_t n);
int memcmp(const void *a, const void *b, size_t n);
size_t strlen(const char *s);
int strcmp(const char *a, const char *b);
int strncmp(const char *a, const char *b, size_t n);
char *strchr(const char *s, int c);
int vsnprintf(char *out, size_t size, const char *format, va_list args);
int snprintf(char *out, size_t size, const char *format, ...);
int fprintf(FILE *f, const char *format, ...);
int fputs(const char *s, FILE *f);
int fflush(FILE *f);
ssize_t write(int fd, const void *data, size_t n);
_Noreturn void exit(int status);
_Noreturn void _Exit(int status);
_Noreturn void abort(void);
int atexit(void (*fn)(void));
char *getenv(const char *name);

typedef long jmp_buf[8];
int _setjmp(jmp_buf env);
_Noreturn void _longjmp(jmp_buf env, int value);
#define setjmp _setjmp
#define longjmp _longjmp
#endif

#ifdef OCEAN_WASM_IMPL
FILE ocean_wasm_stdout = {1}, ocean_wasm_stderr = {2};
FILE *stdout = &ocean_wasm_stdout, *stderr = &ocean_wasm_stderr;

/* ---- memory ---- */
void *memcpy(void *dst, const void *src, size_t n) {
    unsigned char *d = dst; const unsigned char *s = src;
    while (n--) *d++ = *s++;
    return dst;
}
void *memmove(void *dst, const void *src, size_t n) {
    unsigned char *d = dst; const unsigned char *s = src;
    if (d < s) while (n--) *d++ = *s++;
    else { d += n; s += n; while (n--) *--d = *--s; }
    return dst;
}
void *memset(void *dst, int c, size_t n) {
    unsigned char *d = dst;
    while (n--) *d++ = (unsigned char)c;
    return dst;
}
int memcmp(const void *a, const void *b, size_t n) {
    const unsigned char *x = a, *y = b;
    for (; n; n--, x++, y++) if (*x != *y) return *x < *y ? -1 : 1;
    return 0;
}
size_t strlen(const char *s) { size_t n = 0; while (s[n]) n++; return n; }
int strcmp(const char *a, const char *b) {
    while (*a && *a == *b) { a++; b++; }
    return (unsigned char)*a - (unsigned char)*b;
}
int strncmp(const char *a, const char *b, size_t n) {
    for (; n; n--, a++, b++) { if (*a != *b || !*a) return (unsigned char)*a - (unsigned char)*b; }
    return 0;
}
char *strchr(const char *s, int c) {
    for (;; s++) { if (*s == (char)c) return (char *)s; if (!*s) return NULL; }
}

/* A first-fit free list over linear memory; each block carries a 16-byte
 * header holding its usable size (keeps 16-byte alignment). */
typedef struct OcBlock { size_t size; struct OcBlock *next; } OcBlock;
#define OC_HEADER 16
extern unsigned char __heap_base;
static uintptr_t heap_next;
/* The exclusive end can reach 4 GiB even though the cursor must fit uintptr_t. */
static uint64_t heap_end;
static OcBlock *free_blocks;

static void *carve(size_t n) {
    if (!heap_next) {
        uintptr_t base = (uintptr_t)&__heap_base;
        if (base > UINTPTR_MAX - 15) return NULL;
        heap_next = (base + 15) & ~(uintptr_t)15;
        heap_end = (uint64_t)__builtin_wasm_memory_size(0) * 65536;
    }
    if (n > SIZE_MAX - OC_HEADER) return NULL;
    size_t need = OC_HEADER + n;
    if (need > UINTPTR_MAX - heap_next) return NULL;
    uintptr_t next = heap_next + need;
    if (next > heap_end) {
        size_t shortfall = (size_t)(next - heap_end);
        size_t pages = shortfall / 65536 + (shortfall % 65536 != 0);
        if (__builtin_wasm_memory_grow(0, pages) == (size_t)-1) return NULL;
        heap_end += (uint64_t)pages * 65536;
    }
    OcBlock *b = (OcBlock *)heap_next;
    b->size = n;
    heap_next = next;
    return (unsigned char *)b + OC_HEADER;
}
void *malloc(size_t n) {
    if (n > SIZE_MAX - 15 - OC_HEADER) return NULL;
    n = (n + 15) & ~(size_t)15;
    if (!n) n = 16;
    for (OcBlock **link = &free_blocks; *link; link = &(*link)->next) {
        OcBlock *b = *link;
        if (b->size >= n) {
            *link = b->next;
            if (b->size >= n + OC_HEADER + 16) {
                OcBlock *rem = (OcBlock *)((unsigned char *)b + OC_HEADER + n);
                rem->size = b->size - n - OC_HEADER;
                rem->next = free_blocks;
                free_blocks = rem;
                b->size = n;
            }
            return (unsigned char *)b + OC_HEADER;
        }
    }
    return carve(n);
}
void free(void *p) {
    if (!p) return;
    OcBlock *b = (OcBlock *)((unsigned char *)p - OC_HEADER);
    b->next = free_blocks;
    free_blocks = b;
}
void *calloc(size_t count, size_t size) {
    size_t n = count * size;
    if (size && n / size != count) return NULL;
    void *p = malloc(n);
    if (p) memset(p, 0, n);
    return p;
}
void *realloc(void *p, size_t n) {
    if (!p) return malloc(n);
    OcBlock *b = (OcBlock *)((unsigned char *)p - OC_HEADER);
    if (b->size >= n) return p;
    void *q = malloc(n);
    if (q) { memcpy(q, p, b->size); free(p); }
    return q;
}

/* ---- output ---- */
__attribute__((import_module("env"), import_name("ocean_write")))
extern int ocean_host_write(int fd, const void *data, int n);
ssize_t write(int fd, const void *data, size_t n) {
    size_t done = 0;
    while (done < n) {
        size_t rem = n - done;
        int chunk = rem > 0x7fffffffu ? 0x7fffffff : (int)rem;
        int w = ocean_host_write(fd, (const unsigned char *)data + done, chunk);
        if (w <= 0) return done ? (ssize_t)done : w;
        done += (size_t)w;
        if (w < chunk) break;
    }
    return (ssize_t)done;
}

static void put_char(char *out, size_t size, size_t *len, char c) {
    if (*len + 1 < size) out[*len] = c;
    (*len)++;
}
int vsnprintf(char *out, size_t size, const char *f, va_list args) {
    size_t len = 0;
    for (; *f; f++) {
        if (*f != '%') { put_char(out, size, &len, *f); continue; }
        f++;
        while (*f == '-' || *f == '+' || *f == ' ' || *f == '#' || *f == '0') f++;
        if (*f == '*') { (void)va_arg(args, int); f++; }
        else while (*f >= '0' && *f <= '9') f++;
        if (*f == '.') {
            f++;
            if (*f == '*') { (void)va_arg(args, int); f++; }
            else while (*f >= '0' && *f <= '9') f++;
        }
        int longs = 0;
        if (*f == 'h') { f++; if (*f == 'h') f++; }
        else if (*f == 'j' || *f == 't') { longs = 2; f++; }
        else { while (*f == 'l' || *f == 'z') { longs++; f++; } }
        if (*f == '%') { put_char(out, size, &len, '%'); continue; }
        if (*f == 's') { const char *s = va_arg(args, const char *); if (!s) s = "(null)"; while (*s) put_char(out, size, &len, *s++); continue; }
        if (*f == 'c') { put_char(out, size, &len, (char)va_arg(args, int)); continue; }
        if (*f == 'd' || *f == 'i' || *f == 'u' || *f == 'x' || *f == 'X' || *f == 'o' || *f == 'p') {
            unsigned long long v; int neg = 0;
            if (*f == 'p') v = (uintptr_t)va_arg(args, void *);
            else if (*f == 'd' || *f == 'i') {
                long long s = longs >= 2 ? va_arg(args, long long) : longs == 1 ? va_arg(args, long) : va_arg(args, int);
                if (s < 0) { neg = 1; v = 0ull - (unsigned long long)s; } else v = (unsigned long long)s;
            } else v = longs >= 2 ? va_arg(args, unsigned long long) : longs == 1 ? va_arg(args, unsigned long) : va_arg(args, unsigned);
            unsigned base = (*f == 'x' || *f == 'X' || *f == 'p') ? 16 : (*f == 'o' ? 8 : 10);
            const char *digits_hex = *f == 'X' ? "0123456789ABCDEF" : "0123456789abcdef";
            char digits[24]; int k = 0;
            do { digits[k++] = digits_hex[v % base]; v /= base; } while (v);
            if (neg) put_char(out, size, &len, '-');
            while (k) put_char(out, size, &len, digits[--k]);
            continue;
        }
        break;
    }
    if (size) out[len < size ? len : size - 1] = 0;
    return (int)len;
}
int snprintf(char *out, size_t size, const char *format, ...) {
    va_list args; va_start(args, format);
    int n = vsnprintf(out, size, format, args);
    va_end(args);
    return n;
}
int fputs(const char *s, FILE *f) { write(f->fd, s, strlen(s)); return 0; }
int fprintf(FILE *f, const char *format, ...) {
    char buffer[512];
    va_list args; va_start(args, format);
    int n = vsnprintf(buffer, sizeof buffer, format, args);
    va_end(args);
    write(f->fd, buffer, strlen(buffer));
    return n;
}
int fflush(FILE *f) { (void)f; return 0; }

/* ---- process ---- */
_Noreturn void abort(void) { __builtin_trap(); }
_Noreturn void exit(int status) { (void)status; __builtin_trap(); }
_Noreturn void _Exit(int status) { (void)status; __builtin_trap(); }
int atexit(void (*fn)(void)) { (void)fn; return 0; }
char *getenv(const char *name) { (void)name; return NULL; }
int _setjmp(jmp_buf env) { (void)env; return 0; }
_Noreturn void _longjmp(jmp_buf env, int value) { (void)env; (void)value; __builtin_trap(); }
#endif
`;
}
