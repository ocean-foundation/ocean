static HANDLE input_file(const char *input, int64_t size) {
    HANDLE file = temp_file(L"oci");
    if (file == INVALID_HANDLE_VALUE) return INVALID_HANDLE_VALUE;
    for (int64_t done = 0; done < size; ) {
