        if (!out) return 0;
        p->output = out;
        *cap = ncap;
    }
    memcpy(p->output + p->output_size, bytes, count);
    p->output_size += (int64_t)count;
    p->output[p->output_size] = 0;
    return 1;
}
#ifdef _WIN32
static wchar_t *wide(const char *s) {
